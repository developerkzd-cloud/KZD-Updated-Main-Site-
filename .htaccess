RewriteEngine On

# about.html was removed — the About Us section on the homepage replaces it.
# This MUST come before the .html-stripping rules below, or /about.html gets
# rewritten to /about first and falls through to a 404. NE keeps the # literal.
RewriteRule ^about(\.html)?$ /#about [R=301,L,NE]

# Redirect index.html to root domain
RewriteCond %{THE_REQUEST} /index\.html [NC]
RewriteRule ^index\.html$ / [R=301,L]

# Redirect .html URLs to clean versions (removes .html from address bar)
RewriteCond %{THE_REQUEST} \.html [NC]
RewriteRule ^(.*)\.html$ /$1 [R=301,L]

# Internally serve .html files when clean URLs are used
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.*)$ $1.html [L]

# php -- BEGIN cPanel-generated handler, do not edit
# Set the “ea-php82” package as the default “PHP” programming language.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php82 .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit

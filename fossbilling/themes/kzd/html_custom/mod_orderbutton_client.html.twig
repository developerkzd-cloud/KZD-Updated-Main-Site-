{% import "macro_functions.html.twig" as mf %}

{#
  KZD Solutions override of the stock Orderbutton "Login or Register" step.
  Every functional id/name/attribute is unchanged from stock (Bootstrap's
  native Tab component just needs data-bs-toggle="tab" + data-bs-target +
  role="tab" on a button, wherever it lives in the DOM -- it doesn't require
  a specific wrapper) -- only restructured cosmetically:
   - this isn't counted as one of the top-level steps (see
     mod_orderbutton_content.html.twig's #orderSteps -- only Domain and
     Checkout get a chip now). It's a gate that shows up right when a guest
     reaches Checkout, so it gets a lock icon instead of a step number, and
     copy that reads as "you need this to pay", not "step 2 of 3".
   - moved the Sign In / Create Account switch out of a plain text link
     buried under each form (id="in-tab"/id="up-tab" preserved exactly,
     still what Bootstrap's Tab JS binds to) into a real top segmented tab
     bar, matching the Register/Transfer tabs on the Domain step -- so each
     form's bottom row is left with just its one primary submit button.
#}
<div class="accordion-item kzd-order-panel kzd-order-gate">
    <h3 class="accordion-header kzd-order-panel-header">
        {# Guest mirror of the checkout step's resume rule: something in the
           cart means a purchase is already under way, so the gate to finish
           it is the right place to land — not "Select Product". This whole
           template only renders when there is no client, so the signed-in
           case can never collide with it. #}
        {% set kzd_cart = guest.cart_get %}
        {% set kzd_cart_count = kzd_cart.items is defined and kzd_cart.items ? kzd_cart.items|length : 0 %}
        {# Mirrors the products condition on the same axis so the two can never both
           carry `show`. `request.checkout or ...` used to open this with an empty
           cart, which is a sign-in prompt for an order that does not exist -- and,
           once products stopped claiming that state, would have put two panels in a
           data-bs-parent accordion that only honours the first. #}
        {% set kzd_open_register = not request.product and kzd_cart_count > 0 %}
        <button class="accordion-button{% if not kzd_open_register %} collapsed{% endif %}" type="button"
                data-bs-toggle="collapse" data-bs-target="#register" aria-controls="register">
            <span class="kzd-order-panel-step kzd-order-gate-icon"><svg class="icon"><use href="#lock" /></svg></span>
            {{ 'Sign in to complete your order'|trans }}
        </button>
    </h3>
    <div id="register" class="accordion-collapse collapse{% if kzd_open_register %} show{% endif %}"
         data-bs-parent="#orderManager">
        <div class="accordion-body">

            <div class="kzd-panel-tabs" role="tablist">
                <button class="kzd-panel-tab active" id="in-tab" data-bs-toggle="tab" data-bs-target="#sign-in"
                        type="button" role="tab" aria-controls="sign-in" aria-selected="true">{{ 'Sign In'|trans }}</button>
                <button class="kzd-panel-tab" id="up-tab" data-bs-toggle="tab" data-bs-target="#sign-up"
                        type="button" role="tab" aria-controls="sign-up" aria-selected="false">{{ 'Create Account'|trans }}</button>
            </div>

            <div class="tab-content" id="nav-tabContent">
                <div class="tab-pane show active" id="sign-in" role="tabpanel" aria-labelledby="in-tab" tabindex="0">
                    <form method="post" action="{{ 'client/login'|api_url(role: 'guest') }}" {{ fb_api_form({callback: 'onLogin'}) }}>
                        <div class="row">
                            <div class="form-floating col-md-7 mb-3">
                                <input class="form-control form-control-sm" type="email" name="email" id="email"
                                       required="required"
                                       value="{{ request.email }}"
                                       placeholder="{{ 'Email Address'|trans }}"
                                       data-validation-required-message="{{ 'You must fill in your email.'|trans }}">
                                <label for="email" class="ms-2">{{ 'Email Address'|trans }}</label>
                            </div>
                            <div class="form-floating col-md-7 mb-3">
                                <input class="form-control form-control-sm" type="password" name="password" id="password"
                                       required="required"
                                       value="{{ request.password }}"
                                       placeholder="{{ 'Password'|trans }}"
                                       data-validation-required-message="{{ 'You must fill in your password.'|trans }}">
                                <label for="password" class="ms-2">{{ 'Password'|trans }}</label>
                            </div>
                        </div>
                        <button class="btn btn-primary" type="submit">
                            {{ 'Login'|trans }}
                        </button>
                    </form>
                </div>
                <div class="tab-pane" id="sign-up" role="tabpanel" aria-labelledby="up-tab" tabindex="0">
                    <form method="post" action="{{ 'client/create'|api_url(role: 'guest') }}" {{ fb_api_form({callback: 'onAccountCreate'}) }}>

                        {% set r = guest.client_required %}
                        <div class="row">
                            <div class="form-floating col-md-7 mb-3">
                                <input class="form-control form-control-sm" type="email" name="email" id="reg-email"
                                       required="required"
                                       value="{{ request.email }}"
                                       placeholder="{{ 'Email Address'|trans }}">
                                <label for="reg-email" class="ms-2">{{ 'Email Address'|trans }}</label>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-7">
                                <div class="row">
                                    <div class="form-floating col-md-6 mb-3">
                                        <input class="form-control form-control-sm" type="text" name="first_name" id="first-name"
                                               required="required"
                                               value="{{ request.first_name }}"
                                               placeholder="{{ 'First Name'|trans }}">
                                        <label for="first-name" class="ms-2">{{ 'First Name'|trans }}</label>
                                    </div>

                                    <div class="form-floating col-md-6 mb-3">
                                        <input class="form-control form-control-sm" type="text" name="last_name" id="last_name"
                                               value="{{ request.last_name }}"
                                               placeholder="{{ 'Last Name'|trans }}"{% if 'last_name' in r %} required="required"{% endif %}>
                                        <label for="last_name" class="ms-2">{{ 'Last Name'|trans }}</label>
                                    </div>
                                </div>
                            </div>
                        </div>

                        {% if 'company' in r %}
                            <div class="row">
                                <div class="form-floating col-md-7 mb-3">
                                    <input class="form-control form-control-sm" type="text" name="company" id="company"
                                           required="required"
                                           value="{{ request.company }}"
                                           placeholder="{{ 'Company'|trans }}">
                                    <label for="company" class="ms-2">{{ 'Company'|trans }}</label>
                                </div>
                            </div>
                        {% endif %}

                        {% if 'birthday' in r %}
                            <div class="row">
                                <div class="form-floating col-md-7 mb-3">
                                    <input class="form-control form-control-sm" type="date" name="birthday" id="birthday"
                                           placeholder="{{ 'Birthday'|trans }}">
                                    <label for="birthday" class="ms-2">{{ 'Birthday'|trans }}</label>
                                </div>
                            </div>
                        {% endif %}

                        {% if 'gender' in r %}
                            <div class="row">
                                <div class="form-floating col-md-7 mb-3">
                                    <select class="form-select form-select-sm" name="gender" id="gender">
                                        <option value="male">{{ 'Male'|trans }}</option>
                                        <option value="female">{{ 'Female'|trans }}</option>
                                        <option value="nonbinary">{{ 'Non-binary'|trans }}</option>
                                        <option value="other">{{ 'Other'|trans }}</option>
                                    </select>
                                    <label for="gender" class="ms-2">{{ 'You are'|trans }}</label>
                                </div>
                            </div>
                        {% endif %}

                        <div class="row">
                            <div class="form-floating col-md-7 mb-3">
                                <input class="form-control form-control-sm" type="password" name="password" id="reg-password"
                                       required="required"
                                       placeholder="{{ 'Password'|trans }}">
                                <label for="reg-password" class="ms-2">{{ 'Password'|trans }}</label>
                            </div>
                        </div>

                        <div class="row">
                            <div class="form-floating col-md-7 mb-3">
                                <input class="form-control form-control-sm" type="password" name="password_confirm" id="password-confirm"
                                       required="required"
                                       placeholder="{{ 'Confirm Password'|trans }}">
                                <label for="password-confirm" class="ms-2">{{ 'Confirm Password'|trans }}</label>
                            </div>
                        </div>

                        {% if 'address_1' in r %}
                        <div class="row">
                            <div class="form-floating col-md-7 mb-3">
                                <input class="form-control form-control-sm" type="text" name="address_1" id="address_1"
                                       value="{{ request.address_1 }}"
                                       placeholder="{{ 'Address'|trans }}">
                                <label for="address_1" class="ms-2">{{ 'Address'|trans }}</label>
                            </div>
                        </div>
                        {% endif %}

                        {% if 'address_2' in r %}
                        <div class="row">
                            <div class="form-floating col-md-7 mb-3">
                                <input class="form-control form-control-sm" type="text" name="address_2" id="address_2"
                                      value="{{ request.address_2 }}"
                                       placeholder="{{ 'Address 2'|trans }}">
                                <label for="address_2" class="ms-2">{{ 'Address 2'|trans }}</label>
                            </div>
                        </div>
                        {% endif %}

                        {% if 'city' in r %}
                            <div class="row">
                                <div class="form-floating col-md-7 mb-3">
                                    <input class="form-control form-control-sm" type="text" name="city" id="city"
                                           value="{{ request.city }}"
                                           placeholder="{{ 'City'|trans }}">
                                    <label for="city" class="ms-2">{{ 'City'|trans }}</label>
                                </div>
                            </div>
                        {% endif %}

                        {% if 'country' in r %}
                            <div class="row">
                                <div class="form-floating col-md-7 mb-3">
                                    <select class="form-select form-select-sm" name="country" id="country"
                                            required="required">
                                        <option value="">{{ '-- Select Country --'|trans }}</option>
                                        {% for val,label in guest.system_countries %}
                                            <option value="{{ val }}" label="{{ label|e }}" {% if request.country|default('') == val %}selected{% endif %}>{{ label|e }}</option>
                                        {% endfor %}
                                    </select>
                                    <label for="country" class="ms-2">{{ 'Country'|trans }}</label>
                                </div>
                            </div>
                        {% endif %}

                        {% if 'state' in r %}
                            <div class="row">
                                <div class="form-floating col-md-7 mb-3">
                                    <input class="form-control form-control-sm" type="text" name="state" id="state"
                                           value="{{ request.state }}"
                                           placeholder="{{ 'State'|trans }}">
                                    <label for="state" class="ms-2">{{ 'State'|trans }}</label>
                                </div>
                            </div>
                        {% endif %}

                        {% if 'postcode' in r %}
                            <div class="row">
                                <div class="form-floating col-md-7 mb-3">
                                    <input class="form-control form-control-sm" type="text" name="postcode" id="postcode"
                                           value="{{ request.postcode }}"
                                           placeholder="{{ 'Zip/Postal Code'|trans }}">
                                    <label for="postcode" class="ms-2">{{ 'Zip/Postal Code'|trans }}</label>
                                </div>
                            </div>
                        {% endif %}

                        {% if 'phone' in r %}
                            <div class="row">
                                <div class="col-md-7 mb-3">
                                    <label for="phone" class="form-label">{{ 'Phone Number'|trans }}</label>
                                    <input type="hidden" name="phone_cc" id="phone_cc" value="{{ request.phone_cc }}">
                                    <input class="form-control form-control-sm js-phone-input" type="tel" name="phone" id="phone" value="{{ request.phone }}" autocomplete="tel" data-initial-country="{{ request.country|default(guest.system_default_country)|lower }}" required="required" placeholder="{{ 'Phone Number'|trans }}">
                                </div>
                            </div>
                        {% endif %}

                        {% set custom_fields = guest.client_custom_fields %}
                        {% for field_name, field in custom_fields %}
                            {% if field.active %}
                                <div class="row">
                                    <div class="form-floating col-md-7 mb-3">
                                        <input class="form-control form-control-sm" type="text" name="{{ field_name }}" id="{{ field_name }}"
                                               value="{{ request.(field_name) }}"
                                               {% if field.required %}required="required"{% endif %}
                                               placeholder="{{ field_name|capitalize }}">
                                        <label class="ms-2" for="{{ field_name }}">{% if field.title is not empty %}{{ field.title }}{% else %} {{ field_name|capitalize }} {% endif %}</label>
                                    </div>
                                </div>
                            {% endif %}
                        {% endfor %}
                        {{ mf.recaptcha }}
                        {% if settings.signup_tos|default('0') == 'explicit' %}
                            <div class="form-check mb-3">
                                <input class="form-check-input" type="checkbox" value="" id="flexCheckDefault" required>
                                <label class="form-check-label" for="flexCheckDefault">
                                    {# TODO: Make this translatable once support for placeholders is implemented #}
                                    <span>I agree to the <a href="{{ 'tos'|url }}" target="_blank">{{ 'Terms of Service'|trans }}</a> and <a href="{{ 'privacy-policy'|url }}" target="_blank">{{ 'Privacy Policy'|trans }}</a>.</span>
                                </label>
                            </div>
                        {% endif %}
                        <button class="btn btn-primary" type="submit">{{ 'Register'|trans }}</button>
                        {% if settings.signup_tos|default('0') == 'implicit' %}
                            <div class="kzd-tos-implicit">
                                {# TODO: Make this translatable once support for placeholders is implemented #}
                                <span>By creating an account, you agree to our <a href="{{ 'tos'|url }}" target="_blank">{{ 'Terms of Service'|trans }}</a> and <a href="{{ 'privacy-policy'|url }}" target="_blank">{{ 'Privacy Policy'|trans }}</a>.</span>
                            </div>
                        {% endif %}
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

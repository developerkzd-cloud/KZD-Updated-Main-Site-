                    <div class="kzd-reveal-card" style="position: relative; z-index: 2; border-radius: 14px; border: 1px solid rgba(26, 26, 26,0.12); background: #FFFFFF; box-shadow: 0 40px 90px -30px rgba(26, 26, 26,0.4), 0 70px 130px -50px rgba(26, 26, 26,0.32); overflow: hidden;">

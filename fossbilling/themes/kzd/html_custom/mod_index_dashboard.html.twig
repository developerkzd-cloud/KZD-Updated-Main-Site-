                        {% for chip in kzd_prompt_chips %}
                            <button type="button" class="kzd-chip" data-kzd-example-chip="{{ chip.prompt|trans }}" style="padding: 8px 16px; border-radius: 999px; border: 1px solid rgba(26, 26, 26,0.16); background: #FFFFFF; box-shadow: 0 2px 6px -2px rgba(26, 26, 26,0.12); font-size: 13px; font-weight: 600; color: #1A1A1A; cursor: pointer; font-family: inherit; transition: border-color .15s ease, transform .15s ease;">{{ chip.label|trans }}</button>
                        {% endfor %}
                    </div>
                    <p class="kzd-hero-trust" style="margin-top: 14px; display: flex; align-items: center; gap: 7px; font-size: 13px; font-weight: 500; color: #3A3A3A;">
                        <svg class="icon" style="width: 14px; height: 14px; color: #1A1A1A; flex: none;"><use href="#check" /></svg>
                        {{ 'Free to try. No sign-up, no credit card.'|trans }}

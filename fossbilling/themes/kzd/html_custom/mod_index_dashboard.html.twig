                    </div>

                    {# Compact single-line pill (ChatGPT-scale), not the old
                       multi-row textarea box — an animated example brief
                       types itself out in the empty state instead of a
                       static hint. Real typed text always wins: the overlay
                       is hidden by data-kzd-prompt-typing-active the moment
                       the real input has a value, and the animation JS
                       checks that same flag before touching the DOM. #}
                    <form method="get" action="/build" class="kzd-prompt-bar kzd-reveal" data-kzd-prompt-form style="margin-top: 18px; position: relative; display: flex; align-items: center; gap: 8px; border-radius: 999px; border: 1px solid rgba(26, 26, 26,0.12); background: #FFFFFF; box-shadow: 0 1px 2px rgba(26, 26, 26,0.04), 0 24px 48px -24px rgba(26, 26, 26,0.35); padding: 6px 6px 6px 20px; --reveal-delay: 260ms;">
                        <svg class="icon" style="width: 15px; height: 15px; color: #6B6B6B; flex: none;"><use href="#search" /></svg>
                        <div style="position: relative; flex: 1; min-width: 0;">
                            <input type="text" name="prompt" autocomplete="off" data-kzd-prompt-input style="width: 100%; border: 0; outline: none; background: transparent; font-family: inherit; font-size: 15.5px; font-weight: 500; color: #1A1A1A; padding: 12px 0; box-sizing: border-box;">
                            <span class="kzd-prompt-typing" data-kzd-prompt-typing aria-hidden="true" style="position: absolute; inset: 12px 0 auto 0; display: flex; align-items: center; font-size: 15.5px; font-weight: 500; color: #6B6B6B; white-space: nowrap; overflow: hidden; pointer-events: none;">
                                <span data-kzd-prompt-typing-text></span><span class="kzd-prompt-cursor"></span>
                            </span>
                        </div>
                        <button type="submit" class="kzd-prompt-submit kzd-press kzd-magnetic" aria-label="{{ 'Build my website'|trans }}" style="flex: none; width: 42px; height: 42px; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: #1A1A1A; color: #FFFFFF; border: 0; cursor: pointer;">
                            <svg class="icon" style="width: 15px; height: 15px;"><use href="#arrow-right" /></svg>
                        </button>
                    </form>

                    {# Follows the visitor down the page once the hero prompt
                       scrolls away -- phones only (see .kzd-pinned-prompt).
                       A separate element rather than pinning the form above:
                       that one holds its layout in inline styles and is a
                       child of a display:contents wrapper on mobile. The two
                       inputs mirror each other and post the same query. #}
                    <form method="get" action="/build" class="kzd-pinned-prompt" data-kzd-pinned-prompt aria-hidden="true">
                        <svg class="icon kzd-pinned-prompt-icon" aria-hidden="true"><use href="#search" /></svg>
                        <input type="text" name="prompt" autocomplete="off" data-kzd-pinned-input
                               placeholder="{{ 'Describe your business'|trans }}"
                               aria-label="{{ 'Describe your business'|trans }}" tabindex="-1">
                        <button type="submit" class="kzd-pinned-prompt-btn kzd-press"
                                aria-label="{{ 'Build my website'|trans }}" tabindex="-1">
                            <svg class="icon" aria-hidden="true"><use href="#arrow-right" /></svg>
                        </button>
                    </form>

                    <script>
                    (function () {
                        var hero = document.querySelector('[data-kzd-prompt-form]');
                        var pinned = document.querySelector('[data-kzd-pinned-prompt]');
                        if (!hero || !pinned) { return; }

                        /* The hero sits inside .kzd-mesh-zone, which isolates its
                           stacking context -- a fixed child of it is painted over by
                           every later section whatever its z-index. Re-parenting to
                           <body> puts the bar in the root stacking context so it
                           actually sits above the page. It must live in the hero
                           markup for the Twig to stay readable, so the move happens
                           here instead. */
                        if (pinned.parentNode !== document.body) { document.body.appendChild(pinned); }

                        var heroInput = hero.querySelector('[data-kzd-prompt-input]');
                        var pinnedInput = pinned.querySelector('[data-kzd-pinned-input]');

                        /* The bar sits under the site header, so the offset has to
                           be the header's REAL height rather than a guess -- it
                           changes with the announcement bar and between breakpoints. */
                        function syncOffset() {
                            var header = document.querySelector('header');
                            var h = header ? Math.round(header.getBoundingClientRect().height) : 0;
                            document.documentElement.style.setProperty('--kzd-pinned-top', (h > 0 ? h + 8 : 64) + 'px');
                        }
                        syncOffset();
                        window.addEventListener('resize', syncOffset, { passive: true });

                        function setPinned(on) {
                            if (pinned.classList.contains('is-pinned') === on) { return; }
                            pinned.classList.toggle('is-pinned', on);
                            /* Out of the accessibility tree and the tab order while
                               parked, so it is never a second invisible copy of the
                               same form for a keyboard or screen-reader user. */
                            pinned.setAttribute('aria-hidden', on ? 'false' : 'true');
                            pinnedInput.tabIndex = on ? 0 : -1;
                            pinned.querySelector('button').tabIndex = on ? 0 : -1;
                        }

                        /* Shown once the hero prompt has scrolled out of view. An
                           observer rather than a scroll handler: no work on frames
                           where nothing crossed the boundary. */
                        if ('IntersectionObserver' in window) {
                            new IntersectionObserver(function (entries) {
                                entries.forEach(function (e) {
                                    /* Only pin when the hero bar has left upward --
                                       not when it is still below the fold on first
                                       paint, which would show the bar immediately. */
                                    setPinned(!e.isIntersecting && e.boundingClientRect.top < 0);
                                });
                            }, { threshold: 0 }).observe(hero);
                        }

                        /* Whichever one they type into, the other agrees -- so
                           submitting from either carries the same text. */
                        if (heroInput && pinnedInput) {
                            heroInput.addEventListener('input', function () { pinnedInput.value = heroInput.value; });
                            pinnedInput.addEventListener('input', function () { heroInput.value = pinnedInput.value; });
                            pinnedInput.value = heroInput.value;
                        }

                        /* An example chip fills the hero input directly, so mirror
                           after the chip handler has run. */
                        document.querySelectorAll('[data-kzd-example-chip]').forEach(function (chip) {
                            chip.addEventListener('click', function () {
                                setTimeout(function () { if (heroInput && pinnedInput) { pinnedInput.value = heroInput.value; } }, 0);
                            });
                        });

                        /* Submitting empty would just land on /build with nothing;
                           send them back to the hero input instead. */
                        pinned.addEventListener('submit', function (ev) {
                            if (!pinnedInput.value.trim()) {
                                ev.preventDefault();
                                hero.scrollIntoView({ behavior: 'smooth', block: 'center' });
                                setTimeout(function () { if (heroInput) { heroInput.focus(); } }, 400);
                            }
                        });
                    })();
                    </script>

                    <div class="kzd-reveal kzd-chip-row" style="display: flex; flex-wrap: wrap; gap: 9px; margin-top: 14px; --reveal-delay: 320ms;">
                        {# The label is one word so the row stays tight on a phone;
                           the chip inserts a full brief, because a single word is

    {# Section intro — the coverflow strip used to launch straight into
       the sliding cards with zero heading/divider, right below the hero's
       own product-demo mockup. With nothing marking a new section start,
       the two ran together (worst on mobile, where they stack with only
       padding between them and no visual anchor telling you the page
       moved on) — every other section on this homepage gets an eyebrow +
       heading before its content, this was the one exception. #}
    <div style="padding: 0 32px; max-width: 1240px; margin: 40px auto 0;">
        <div class="kzd-reveal" style="border-top: 2px solid rgba(26, 26, 26,0.14); padding-top: clamp(24px, 3vw, 36px); text-align: center;">
            <div class="kzd-ed-eyebrow" style="justify-content: center;">{{ 'No coding needed'|trans }}</div>
            <h2 class="kzd-ed-h2" style="margin: 12px 0 0; font-size: clamp(26px, 3.2vw, 40px); text-wrap: balance; max-width: 20ch; margin-left: auto; margin-right: auto;">{{ 'Friction-free. The only limit is your imagination.'|trans }}</h2>
        </div>
    </div>

    {# Ambient proof strip, replacing the old "also need a domain" utility
       bar. Previously this rendered fabricated mockups (fake nav labels,
       generic icon-placeholder "cards"/"split" layouts) standing in for
       what the AI builder drafts — not actually real. Replaced with real
       screenshots of five sites the builder generated, one per style
       profile so the strip actually demonstrates category range (hotel,
       salon, retail, agency, SaaS) instead of three similar warm-local-
       business examples. Cropped to keep each site's own real navbar +
       hero + a peek of the next section (builder-editor chrome trimmed
       off, and enough margin below the hero for this section's own label
       scrim not to collide with it), stored locally so this doesn't
       depend on the builder app being reachable at render time. #}
    {# One entry per card AND per pill in the bar below -- the same array
       drives both, so the label the bar shows can never drift from the card
       it is naming. `type` is the short form for the pill; `category` is the
       card's own label. #}
    {# Real generated sites, one per business type. Stored under
       img/showcase/ -- deliberately NOT img/templates/, which is the
       builder's own blueprint reference material (design-reference/*.md +
       src/design/styleProfiles.js in the builder app). These are marketing
       screenshots of finished output; nothing about them feeds a
       generation, but the separate folder keeps that unambiguous rather
       than relying on people remembering it. #}
    {% set kzd_templates = [
        { name: 'Studio Lumen', slug: 'studiolumen.co.za', category: 'Hair & skin salon',
          type: 'Salons & spas', photo: 'build/img/showcase/studio-lumen.jpg'|asset_url },
        { name: 'Saffron Terrace', slug: 'saffronterrace.co.za', category: 'Restaurant',
          type: 'Restaurants & cafes', photo: 'build/img/showcase/saffron-terrace.jpg'|asset_url },
        { name: 'Clay & Co', slug: 'clayandco.co.za', category: 'Online store',
          type: 'Online stores', photo: 'build/img/showcase/clay-co.jpg'|asset_url },
        { name: 'Harbour House', slug: 'harbourhouse.co.za', category: 'Guesthouse',
          type: 'Guesthouses', photo: 'build/img/showcase/harbour-house.jpg'|asset_url },
        { name: 'Northbound Studio', slug: 'northboundstudio.co.za', category: 'Creative studio',
          type: 'Agencies & studios', photo: 'build/img/templates/agency.jpg'|asset_url }
    ] %}
    {# Coverflow, third build -- see the CSS comment on .kzd-coverflow-stage
       for what's actually different this time (pure CSS @keyframes, zero
       JS -- no interval, no per-frame inline style writes). Each card's
       position in the cycle comes from :nth-child + a phase-shifted
       animation-delay, not a JS-computed index. #}
    <section id="templates-strip" style="padding: 32px 32px clamp(64px, 7vw, 104px); overflow: hidden;">
        <div class="kzd-coverflow-stage">
            {% for t in kzd_templates %}
                <div class="kzd-cf-card">
                    {# The label is a SIBLING of the artwork, not a child of it.
                       Inside, it could only ever sit on top of the screenshot;
                       outside, the phone layout can place it underneath while
                       desktop still positions it absolutely over the card (the
                       .kzd-cf-card box is the same rect, so nothing moves). #}
                    <div class="kzd-template-card">
                        <img class="kzd-tpl-real-shot" src="{{ t.photo }}" alt="{{ t.name }}" loading="lazy" decoding="async">
                    </div>
                    <div class="kzd-template-label">
                        {{ t.name|trans }}
                        <span class="kzd-template-label-category">{{ t.category|trans }}</span>
                    </div>
                </div>
            {% endfor %}
        </div>

        {# Names whichever card is front and centre, and travels with them.
           aria-hidden because it is a visual position indicator whose text
           repeats each card's own visible label -- announcing it as well, and
           re-announcing it every few seconds, would only be noise. #}
        <div class="kzd-types-tabs-wrap" data-kzd-types aria-hidden="true">
            <div class="kzd-types-tabs" data-kzd-types-tabs>
                <span class="kzd-types-notch" data-kzd-types-notch></span>
                {% for t in kzd_templates %}
                    <span class="kzd-types-tab" data-kzd-type-pill>{{ t.type|trans }}</span>
                {% endfor %}
            </div>
        </div>
    </section>

    {# Hosting plans -- all four side by side (see the .kzd-pp CSS above for
       the Refero research behind the design). Prices and features read from
       FOSSBilling, not from the template. #}
    {% set kzd_plan_lines = {
        'hosting-starter': 'Great for a personal site or a first business page.',
        'hosting-basic': 'A step up once one site is not enough.',
        'hosting-standard': 'Our most popular plan for small businesses.',
        'hosting-business': 'For growing businesses running several sites.'
    } %}
    {% set kzd_plans = [] %}
    {% for cat in categories %}
        {% for p in cat.products|filter(p => p.slug starts with 'hosting-') %}
            {% set kzd_plans = kzd_plans|merge([p]) %}
        {% endfor %}
    {% endfor %}

    {# Months free per term, derived from the real prices: a term costing
       ten months of the monthly rate over twelve is two months free. Read
       across every plan and only stated when they all agree -- one plan
       priced differently would make a single global claim false. #}
    {% set kzd_free_y = kzd_plans|map(p => (12 - ((p.pricing.recurrent['1Y'].price|default(0)) / (p.pricing.recurrent['1M'].price|default(1))))|round(0))|sort %}
    {% set kzd_free_2y = kzd_plans|map(p => (24 - ((p.pricing.recurrent['2Y'].price|default(0)) / (p.pricing.recurrent['1M'].price|default(1))))|round(0))|sort %}
    {% set kzd_has_2y = kzd_plans|filter(p => (p.pricing.recurrent['2Y'].price|default(0)) > 0)|length == kzd_plans|length %}

    {# Every plan's feature lines, read from its product description, so the
       cards cannot disagree with what is actually sold. Lines found in every
       plan are lifted out into one shared row; each card keeps only what
       differs between plans. #}
    {% set kzd_plans_sorted = kzd_plans|sort((a, b) => a.priority <=> b.priority) %}
    {% set kzd_all_feats = kzd_plans_sorted|map(p => (p.description|default(''))|split('\n')|filter(l => l|trim starts with '- ')|map(l => l|trim|slice(2))) %}
    {% set kzd_shared_feats = (kzd_all_feats|first)|filter(f => kzd_all_feats|filter(fl => f in fl)|length == kzd_all_feats|length) %}

    {% if kzd_plans|length > 0 %}
    <section id="plans" class="kzd-pp pp-body kzd-reveal" style="padding: 0 32px;"
             data-kzd-plans>
        <div style="max-width: 1240px; margin: 0 auto;">
            <div class="kzd-tier-head">
                <div>
                    <div class="kzd-tier-eyebrow">{{ 'South African hosting, managed for you'|trans }}</div>
                    <h2 class="kzd-tier-title">{{ 'Pick a plan, we run the rest'|trans }}</h2>
                    <p class="kzd-tier-lede">{{ 'Prices in rand, VAT included. Switch to yearly billing to see what you save.'|trans }}</p>
                </div>

                <div class="kzd-tier-billing">
                    <div class="kzd-tier-toggle" role="group" aria-label="{{ 'Billing period'|trans }}">
                        <button type="button" data-kzd-period="1M" aria-pressed="true">{{ 'Monthly'|trans }}</button>
                        <button type="button" data-kzd-period="1Y" aria-pressed="false">{{ 'Yearly'|trans }}</button>
                        {% if kzd_has_2y %}
                            <button type="button" data-kzd-period="2Y" aria-pressed="false">{{ '2 Years'|trans }}</button>
                        {% endif %}
                    </div>
                    {# The saving belongs to the term, so it changes with it, and
                       is empty on monthly where there is nothing to claim. It is
                       derived from the real prices and only shown when every
                       plan agrees on it. #}
                    <span class="kzd-tier-saving" data-kzd-saving aria-live="polite"
                          data-saving-1m=""
                          data-saving-1y="{% if kzd_free_y|first == kzd_free_y|last and kzd_free_y|first > 0 %}{{ '%d months free'|trans|format(kzd_free_y|first) }}{% endif %}"
                          data-saving-2y="{% if kzd_free_2y|first == kzd_free_2y|last and kzd_free_2y|first > 0 %}{{ '%d months free'|trans|format(kzd_free_2y|first) }}{% endif %}"></span>
                </div>
            </div>

            <div class="kzd-tier-grid">
                {% for p in kzd_plans_sorted %}
                    {% set m_price = p.pricing.recurrent['1M'].price|default(0) %}
                    {% set y_price = p.pricing.recurrent['1Y'].price|default(0) %}
                    {% set b_price = p.pricing.recurrent['2Y'].price|default(0) %}
                    {% set best = p.slug == 'hosting-standard' %}
                    {% set short = p.title|replace({' Hosting': ''}) %}
                    {% set feats = kzd_all_feats[loop.index0]|filter(f => f not in kzd_shared_feats) %}
                    <article class="kzd-tier-card{{ best ? ' is-best' }}" aria-labelledby="kzd-plan-{{ p.id }}">
                        <div class="kzd-tier-name-row">
                            <h3 class="kzd-tier-name" id="kzd-plan-{{ p.id }}">{{ short }}</h3>
                            {% if best %}<span class="kzd-tier-badge">{{ 'Most popular'|trans }}</span>{% endif %}
                        </div>
                        <p class="kzd-tier-desc">{{ kzd_plan_lines[p.slug]|default('')|trans }}</p>

                        <div class="kzd-tier-amount-row">
                            <span class="kzd-tier-rand">R</span>
                            {# Yearly carries the real annual total, not a per-month
                               figure derived from it. #}
                            <span class="kzd-tier-amount" data-kzd-price
                                  data-price-1m="{{ m_price|number_format(0, '.', ',') }}"
                                  data-price-1y="{{ y_price|number_format(0, '.', ',') }}"
                                  {% if b_price > 0 %}data-price-2y="{{ b_price|number_format(0, '.', ',') }}"{% endif %}>{{ m_price|number_format(0, '.', ',') }}</span>
                            <span class="kzd-tier-per" data-kzd-per
                                  data-per-1m="{{ '/mo'|trans }}"
                                  data-per-1y="{{ '/year'|trans }}"
                                  {% if b_price > 0 %}data-per-2y="{{ '/2 years'|trans }}"{% endif %}>{{ '/mo'|trans }}</span>
                        </div>
                        {# The per-month equivalent is the note, not the headline:
                           it helps comparison but is not what gets charged. #}
                        <div class="kzd-tier-note" data-kzd-billed
                             data-billed-1m="{{ 'Billed monthly'|trans }}"
                             data-billed-1y="{{ 'Works out to'|trans }} R{{ (y_price / 12)|number_format(2, '.', ',') }}{{ '/mo'|trans }}"
                             {% if b_price > 0 %}data-billed-2y="{{ 'Works out to'|trans }} R{{ (b_price / 24)|number_format(2, '.', ',') }}{{ '/mo'|trans }}"{% endif %}>{{ 'Billed monthly'|trans }}</div>

                        <a class="kzd-tier-cta" href="{{ 'order'|url(query: { 'product': p.id }) }}">
                            {{ 'Get started'|trans }}
                            <svg width="15" height="15" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                        </a>

                        <ul class="kzd-tier-feats">
                            {% for f in feats %}
                                {% set words = f|split(' ') %}
                                <li>
                                    <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8.5L6.2 11.5L13 4.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
                                    {% if f matches '/^\\d+ GB /' %}
                                        <span><strong>{{ words|slice(0, 2)|join(' ') }}</strong> {{ words|slice(2)|join(' ') }}</span>
                                    {% elseif f matches '/^\\d+ /' %}
                                        <span><strong>{{ words|first }}</strong> {{ words|slice(1)|join(' ') }}</span>
                                    {% else %}
                                        <span>{{ f }}</span>
                                    {% endif %}
                                </li>
                            {% endfor %}
                        </ul>
                    </article>
                {% endfor %}
            </div>

            {# Swipe controls for the paired layout (hidden at four-across). #}
            <div class="kzd-tier-nav" data-kzd-tier-nav>
                <button type="button" class="kzd-tier-arrow" data-kzd-tier-prev aria-label="{{ 'Previous plans'|trans }}">
                    <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M10 3.5 5.5 8l4.5 4.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </button>
                <div class="kzd-tier-dots" aria-hidden="true">
                    {% for p in kzd_plans_sorted %}<span></span>{% endfor %}
                </div>
                <button type="button" class="kzd-tier-arrow" data-kzd-tier-next aria-label="{{ 'More plans'|trans }}">
                    <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M6 3.5 10.5 8 6 12.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </button>
            </div>
            <script>
            (function () {
                var grid = document.querySelector('#plans .kzd-tier-grid');
                var nav = document.querySelector('[data-kzd-tier-nav]');
                if (!grid || !nav) { return; }
                var cards = [].slice.call(grid.querySelectorAll('.kzd-tier-card'));
                var dots = [].slice.call(nav.querySelectorAll('.kzd-tier-dots span'));
                var prev = nav.querySelector('[data-kzd-tier-prev]');
                var next = nav.querySelector('[data-kzd-tier-next]');
                function step() { return cards[1] ? cards[1].offsetLeft - cards[0].offsetLeft : grid.clientWidth; }
                function sync() {
                    var max = grid.scrollWidth - grid.clientWidth;
                    var left = grid.scrollLeft;
                    var gl = grid.getBoundingClientRect();
                    // a dot is lit for every card that is mostly on screen
                    cards.forEach(function (c, i) {
                        var r = c.getBoundingClientRect();
                        var shown = Math.min(r.right, gl.right) - Math.max(r.left, gl.left);
                        if (dots[i]) { dots[i].classList.toggle('is-on', shown > r.width * 0.6); }
                    });
                    prev.disabled = left <= 2;
                    next.disabled = left >= max - 2;
                }
                prev.addEventListener('click', function () { grid.scrollBy({ left: -step(), behavior: 'smooth' }); });
                next.addEventListener('click', function () { grid.scrollBy({ left: step(), behavior: 'smooth' }); });
                grid.addEventListener('scroll', sync, { passive: true });
                window.addEventListener('resize', sync, { passive: true });
                if (document.fonts && document.fonts.ready) { document.fonts.ready.then(sync); }
                sync();
            })();
            </script>

            {% if kzd_shared_feats|length > 0 %}
                <div class="kzd-tier-shared">
                    <span class="kzd-tier-shared-label">{{ 'Every plan includes'|trans }}</span>
                    <ul>
                        {% for f in kzd_shared_feats %}
                            <li>
                                <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8.5L6.2 11.5L13 4.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
                                {{ f }}
                            </li>
                        {% endfor %}
                    </ul>
                </div>
            {% endif %}
        </div>
    </section>
    {% endif %}

    </div>

    {# Editorial/modernist system for the sections below, built from a
       client-supplied reference (Archivo black-weight type, hairline
       dividers instead of cards, grayscale-style image tiles, a CSS
       grid-rows FAQ accordion) — implemented structurally as given,
       recoloured to KZD's own navy instead of the reference's red, on the
       site's own white canvas instead of the reference's warm-gray one.
       The stat band and the solid-fill CTA band that also came from this
       reference were removed at the client's request. #}
    {# Replaces the earlier card-grid-with-thumbnail attempt. The design this
       replaces it with was never new work: /support/kb (this page's own
       "Browse all guides" destination) already implements, in production,
       exactly the search-bar-plus-category-columns help-centre pattern
       asked for here, using the .kzd-kb-* classes already shipped in
       kzd-overrides.css site-wide. This section is a condensed teaser built
       from THAT same proven markup/CSS, not a new design — real categories,
       real per-category article counts, real article links, the same
       "no article in this topic yet" honesty for an empty category instead
       of reserving blank space for one (see mod_support_kb_index.html.twig
       for the full write-up of why that matters). Search here posts to the
       real /support/kb search (?q=), the same query param that page reads. #}
    {% if kb_enabled %}
        {% set kb_categories_home = guest.support_kb_category_get_list %}
        {% if kb_categories_home.list|length > 0 %}
            <section id="posts" class="kzd-pp pp-body" style="padding: clamp(56px, 7vw, 96px) 32px clamp(48px, 6vw, 88px);">
                <div style="max-width: 1240px; margin: 0 auto;">
                    <div class="kzd-guides-head kzd-reveal">
                        <div>
                            <div class="kzd-guides-eyebrow">{{ 'Knowledge base'|trans }}</div>
                            <h2 class="kzd-guides-title">{{ 'Hosting guides, written by the support team'|trans }}</h2>
                            <p class="kzd-guides-lede">{{ 'Search our knowledge base, or browse by topic below.'|trans }}</p>
                        </div>
                        <a href="{{ 'support/kb'|url }}" class="kzd-guides-all">
                            {{ 'Browse all guides'|trans }}
                            <svg width="15" height="15" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                        </a>
                    </div>

                    <form method="get" action="{{ 'support/kb'|url }}" class="kzd-kb-search kzd-reveal" role="search" style="margin: 28px 0 32px;">
                        <svg class="icon kzd-kb-search-icon" aria-hidden="true"><use href="#search" /></svg>
                        <input name="q" type="search" placeholder="{{ 'Search for an answer'|trans }}" aria-label="{{ 'Search the knowledge base'|trans }}">
                        <button type="submit">{{ 'Search'|trans }}</button>
                    </form>

                    <div class="kzd-kb-cats">
                        {% for category in kb_categories_home.list %}
                            {% set kb_count = category.articles is defined and category.articles ? category.articles|length : 0 %}
                            <div class="kzd-kb-cat kzd-reveal-card" style="--reveal-delay: {{ loop.index0 * 80 }}ms;">
                                <div class="kzd-kb-cat-icon">
                                    <svg class="icon" aria-hidden="true"><use href="#{{ category.slug == 'faq' ? 'lifebuoy' : 'book' }}" /></svg>
                                </div>
                                <div class="kzd-kb-cat-head">
                                    <h3><a href='{{ "support/kb/#{category.slug}"|url }}'>{{ category.title }}</a></h3>
                                    {% if kb_count %}
                                        <span class="kzd-kb-cat-count">{{ kb_count }} {{ (kb_count == 1 ? 'article' : 'articles')|trans }}</span>
                                    {% endif %}
                                </div>
                                {% if kb_count %}
                                    <ul class="kzd-kb-cat-list">
                                        {% for article in category.articles|slice(0, 4) %}
                                            <li>
                                                <a href='{{ "support/kb/#{article.category.slug}/#{article.slug}"|url }}'>
                                                    <span>{{ article.title }}</span>
                                                    <svg class="icon" aria-hidden="true"><use href="#arrow-right" /></svg>
                                                </a>
                                            </li>
                                        {% endfor %}
                                    </ul>
                                {% else %}
                                    <p class="kzd-kb-cat-empty">{{ 'No articles in this topic yet.'|trans }}</p>
                                {% endif %}
                            </div>
                        {% endfor %}
                    </div>

                    <div class="kzd-kb-ask kzd-reveal" style="margin-top: 32px;">
                        <div>
                            <strong>{{ "Can't find what you need?"|trans }}</strong>
                            <span>{{ 'Our support team will point you in the right direction.'|trans }}</span>
                        </div>
                        <a class="kzd-kb-btn-primary" href="{{ guest_support_url }}">{{ 'Contact support'|trans }}</a>
                    </div>
                </div>
            </section>
        {% endif %}
    {% endif %}

    <section id="faq" class="kzd-ed" style="padding: 0 32px clamp(56px, 7vw, 104px);">
        <div style="max-width: 760px; margin: 0 auto; border-top: 2px solid rgba(26, 26, 26,0.14); padding-top: clamp(24px, 3vw, 36px);">
            <h2 class="kzd-reveal kzd-faqcard-title">{{ 'Frequently Asked Questions'|trans }}</h2>

            <div class="kzd-faqcard-list">
                {% for q in [
                    { q: 'How long does domain registration take?', a: 'Most domains are registered and active within minutes of a successful payment. Some country-code extensions may take slightly longer while WHOIS records propagate.' },
                    { q: 'Can I use my own nameservers?', a: 'Yes. During checkout in your client portal you can choose to use your own nameservers instead of the KZD Solutions defaults.' },
                    { q: 'How do I manage my domain after registering?', a: 'Every domain you register is manageable from your KZD Solutions client dashboard, where you can update nameservers, contact details, and renewal settings.' },
                    { q: 'What happens when my domain is about to expire?', a: 'You\'ll receive renewal reminders by email ahead of your expiry date, and can renew directly from your client dashboard.' },
                ] %}
                    <div class="kzd-faqcard kzd-reveal" style="--reveal-delay: {{ loop.index0 * 60 }}ms;" data-kzd-faqcard>
                        <button type="button" class="kzd-faqcard-btn" data-kzd-faqcard-trigger>
                            <span class="kzd-faqcard-q">{{ q.q|trans }}</span>
                            <span class="kzd-faqcard-icon" data-kzd-faqcard-icon>+</span>
                        </button>
                        <div class="kzd-faqcard-panel" data-kzd-faqcard-panel>
                            <div style="overflow: hidden;">
                                <p class="kzd-faqcard-a">{{ q.a|trans }}</p>
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>
        </div>
    </section>

    <div style="line-height: 0; background: #FFFFFF;" aria-hidden="true">
        <svg viewBox="0 0 1440 60" preserveAspectRatio="none" style="display: block; width: 100%; height: 48px;">
            <path d="M0,30 C240,60 480,0 720,20 C960,40 1200,10 1440,30 L1440,60 L0,60 Z" fill="#1A1A1A"></path>
        </svg>
    </div>
    <footer class="kzd-footer" style="background: #1A1A1A; color: #A7A7A7; padding: 64px 32px 0; position: relative;">
        <div class="kzd-gradient-bar" style="position: absolute; top: 0; left: 0; right: 0; height: 2px; opacity: 0.6;"></div>
        <div style="max-width: 1240px; margin: 0 auto;">
            <div class="kzd-footer-grid">
                <div class="kzd-footer-brand">
                    <div style="display: flex; align-items: center; gap: 9px;">
                        {% if company.logo_url_dark or company.logo_url %}
                            <img src="{{ company.logo_url_dark|default(company.logo_url) }}" alt="{{ company.name }}" style="height: 30px; width: auto; display: block;">
                        {% endif %}
                        <span style="font-weight: 700; font-size: 18px; letter-spacing: -0.01em; color: #FFFFFF;">{{ company.name|default('KZD Solutions') }}</span>
                    </div>
                    <p style="font-size: 13.5px; line-height: 1.7; color: #A7A7A7; margin: 18px 0 0; max-width: 230px;">{{ 'Hosting, domains and billing for South African business, run by KZD Solutions from Durban.'|trans }}</p>
                    {% if company.tel is defined and company.tel %}<p style="font-size: 13.5px; color: #A7A7A7; margin: 14px 0 0;">{{ company.tel }}</p>{% endif %}
                    {% if company.email is defined and company.email %}<p style="font-size: 13.5px; margin: 4px 0 0;"><a href="mailto:{{ company.email }}" class="kzd-footer-link">{{ company.email }}</a></p>{% endif %}
                </div>

                {# Each link group is a plain, always-open block on desktop; the
                   same markup becomes a click-to-expand accordion once the
                   mobile media query takes over (CSS-only switch, same trick
                   the FAQ cards use) -- see kzd-footeracc rules below. #}
                <div class="kzd-footer-col" data-kzd-footeracc>
                    <button type="button" class="kzd-footer-col-head" data-kzd-footeracc-trigger>
                        <h3>{{ 'Hosting'|trans }}</h3>
                        <span class="kzd-footeracc-icon" aria-hidden="true">+</span>
                    </button>
                    <div class="kzd-footeracc-panel"><div class="kzd-footeracc-inner">
                        <button type="button" class="kzd-footer-link kzd-footer-link-btn" data-kzd-menu-trigger="hosting">{{ 'Shared hosting'|trans }}</button>
                        <button type="button" class="kzd-footer-link kzd-footer-link-btn" data-kzd-menu-trigger="hosting">{{ 'Business email'|trans }}</button>
                        <a href="#domains" class="kzd-footer-link">{{ 'Domain registration'|trans }}</a>
                        <a href="{{ 'order'|url }}" class="kzd-footer-link">{{ 'All plans'|trans }}</a>
                    </div></div>
                </div>

                <div class="kzd-footer-col" data-kzd-footeracc>
                    <button type="button" class="kzd-footer-col-head" data-kzd-footeracc-trigger>
                        <h3>{{ 'Company'|trans }}</h3>
                        <span class="kzd-footeracc-icon" aria-hidden="true">+</span>
                    </button>
                    <div class="kzd-footeracc-panel"><div class="kzd-footeracc-inner">
                        <a href="{{ 'about-us'|url }}" class="kzd-footer-link">{{ 'About us'|trans }}</a>
                        <a href="{{ guest_support_url }}" class="kzd-footer-link">{{ 'Contact us'|trans }}</a>
                        <a href="{{ 'login'|url }}" class="kzd-footer-link">{{ 'Client area'|trans }}</a>
                    </div></div>
                </div>

                <div class="kzd-footer-col" data-kzd-footeracc>
                    <button type="button" class="kzd-footer-col-head" data-kzd-footeracc-trigger>
                        <h3>{{ 'Help'|trans }}</h3>
                        <span class="kzd-footeracc-icon" aria-hidden="true">+</span>
                    </button>
                    <div class="kzd-footeracc-panel"><div class="kzd-footeracc-inner">
                        <a href="{{ guest_support_url }}" class="kzd-footer-link">{{ 'Open a ticket'|trans }}</a>
                        <a href="#faq" class="kzd-footer-link">{{ 'FAQ'|trans }}</a>
                        {% if kb_enabled %}<a href="{{ 'support/kb'|url }}" class="kzd-footer-link">{{ 'Knowledge base'|trans }}</a>{% endif %}
                        <a href="{{ 'signup'|url }}" class="kzd-footer-link">{{ 'Create an account'|trans }}</a>
                    </div></div>
                </div>

                {# No subscriber list exists in FOSSBilling, so this doesn't
                   pretend to add one -- it opens the visitor's own mail
                   client addressed to KZD with their address in the body.
                   Honest placeholder for a real ESP integration later. #}
                <div class="kzd-footer-newsletter">
                    <h3>{{ 'Stay in the loop'|trans }}</h3>
                    <p>{{ 'Hosting tips, uptime notices and offers. No spam, unsubscribe any time.'|trans }}</p>
                    <form class="kzd-footer-newsletter-form" onsubmit="event.preventDefault(); var v=this.querySelector('input').value.trim(); if(v){ window.location.href='mailto:{{ company.email|default('hello@kzdsolutions.co.za') }}?subject=' + encodeURIComponent('Subscribe me to updates') + '&body=' + encodeURIComponent('Please add ' + v + ' to your mailing list.'); }">
                        <input type="email" required placeholder="{{ 'Email address'|trans }}" aria-label="{{ 'Email address'|trans }}" class="kzd-footer-newsletter-input">
                        <button type="submit" class="kzd-footer-newsletter-btn">{{ 'Subscribe'|trans }}</button>
                    </form>
                </div>
            </div>

            <div class="kzd-footer-bottom">
                <span>&copy; {{ "now"|date("Y") }} {{ company.name|default('KZD Solutions') }}. {{ 'All rights reserved.'|trans }}</span>
                <span class="kzd-footer-bottom-legal">
                    <a href="{{ 'tos'|url }}" class="kzd-legal-link">{{ 'Terms'|trans }}</a>
                    <a href="{{ 'privacy-policy'|url }}" class="kzd-legal-link">{{ 'Privacy'|trans }}</a>
                </span>
                <span class="kzd-footer-bottom-secure">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" width="14" height="14" aria-hidden="true"><rect x="5" y="11" width="14" height="9" rx="2"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/></svg>
                    {{ 'Secure payment via encrypted card checkout'|trans }}
                </span>
                <button type="button" class="kzd-footer-backtotop" onclick="window.scrollTo({top:0,behavior:'smooth'})">{{ 'Back to top'|trans }} <span aria-hidden="true">&uarr;</span></button>
            </div>
        </div>
    </footer>
</div>

<script>
(function () {
    var reduceMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduceMotion) { return; }

    // Cursor-reactive spotlight — tracks the pointer inside every
    // .kzd-spotlight card (all pricing/domain/KB/promise cards) and sets
    // --mx/--my as percentages for the radial-gradient glow in CSS.
    // rAF-throttled so it never fires more than once per frame.
    var spotlightEls = document.querySelectorAll('.kzd-spotlight');
    if (spotlightEls.length) {
        var pending = null;
        document.addEventListener('mousemove', function (e) {
            if (pending) { return; }
            pending = requestAnimationFrame(function () {
                pending = null;
                spotlightEls.forEach(function (el) {
                    var r = el.getBoundingClientRect();
                    if (e.clientX < r.left - 40 || e.clientX > r.right + 40 || e.clientY < r.top - 40 || e.clientY > r.bottom + 40) { return; }
                    el.style.setProperty('--mx', ((e.clientX - r.left) / r.width * 100) + '%');
                    el.style.setProperty('--my', ((e.clientY - r.top) / r.height * 100) + '%');
                });
            });
        }, { passive: true });
    }

    // Magnetic primary CTA — drifts up to 10px toward the cursor within a
    // 90px radius, spring-back via the CSS transition when the cursor
    // leaves. One button only (the hero's "Build my website") — applying
    // this to every button would be exactly the "everything animates"
    // anti-pattern motion.md warns against.
    var magnets = document.querySelectorAll('.kzd-magnetic');
    magnets.forEach(function (btn) {
        var radius = 90, strength = 0.35;
        btn.addEventListener('mousemove', function (e) {
            var r = btn.getBoundingClientRect();
            var dx = e.clientX - (r.left + r.width / 2);
            var dy = e.clientY - (r.top + r.height / 2);
            btn.style.setProperty('--mag-x', (dx * strength) + 'px');
            btn.style.setProperty('--mag-y', (dy * strength) + 'px');
        });
        btn.addEventListener('mouseleave', function () {
            btn.style.setProperty('--mag-x', '0px');
            btn.style.setProperty('--mag-y', '0px');
        });
    });

    // Hero mesh parallax — the colourful animated gradient blobs behind
    // the opening hero drift a few px opposite the cursor, so the whole
    // background reads as a physical layer with depth instead of a flat
    // painted backdrop. Capped small (±14px) — this is atmosphere, not a
    // gimmick, per the motion guide's "when in doubt, subtler" rule.
    var meshZone = document.querySelector('.kzd-mesh-zone');
    var meshParallax = document.querySelector('.kzd-mesh-parallax');
    if (meshZone && meshParallax) {
        var meshPending = null;
        meshZone.addEventListener('mousemove', function (e) {
            if (meshPending) { return; }
            meshPending = requestAnimationFrame(function () {
                meshPending = null;
                var r = meshZone.getBoundingClientRect();
                var px = (e.clientX - r.left) / r.width - 0.5;
                var py = (e.clientY - r.top) / r.height - 0.5;
                meshParallax.style.transform = 'translate(' + (px * -14) + 'px, ' + (py * -14) + 'px)';
            });
        }, { passive: true });
        meshZone.addEventListener('mouseleave', function () {
            meshParallax.style.transform = '';
        });
    }
})();

(function () {
    // FAQ cards — each toggles independently (any number can be open at
    // once); all the open/close visuals (grid-rows height, icon rotation)
    // are pure CSS driven off the card's own .is-open state.
    var triggers = document.querySelectorAll('[data-kzd-faqcard-trigger]');
    triggers.forEach(function (btn) {
        btn.addEventListener('click', function () {
            var card = btn.closest('[data-kzd-faqcard]');
            card.classList.toggle('is-open');
        });
    });
})();

(function () {
    // Footer link groups — same independent-toggle wiring as the FAQ
    // cards above. The click handler runs at every width, but only the
    // mobile media query gives kzd-footer-col-head a pointer cursor and
    // animates kzd-footeracc-panel's height, so on desktop this is an
    // inert no-op and the group just stays open.
    var footerTriggers = document.querySelectorAll('[data-kzd-footeracc-trigger]');
    footerTriggers.forEach(function (btn) {
        btn.addEventListener('click', function () {
            var col = btn.closest('[data-kzd-footeracc]');
            col.classList.toggle('is-open');
        });
    });
})();

(function () {
    var tabs = document.querySelectorAll('[data-kzd-tab]');
    tabs.forEach(function (btn) {
        btn.addEventListener('click', function () {
            var target = btn.getAttribute('data-kzd-tab');
            document.querySelectorAll('[data-kzd-tab]').forEach(function (b) { b.classList.remove('is-active'); });
            document.querySelectorAll('[data-kzd-panel]').forEach(function (p) { p.classList.remove('is-active'); });
            btn.classList.add('is-active');
            var panel = document.querySelector('[data-kzd-panel="' + target + '"]');
            if (panel) {
                panel.classList.add('is-active');
                if (window.kzdReplayReveal) { window.kzdReplayReveal(panel); }
            }
        });
    });
})();

(function () {
    // Animated typing placeholder on the homepage's own prompt bar (a
    // separate piece of markup from the AI Website Builder app itself —
    // both got this treatment). A real "type it out, hold, delete, next
    // phrase" loop via setTimeout, not a static placeholder swap or a
    // CSS-only reveal — the content itself changes every frame, and a
    // blinking cursor needs a real DOM element to blink. Stops the moment
    // the visitor types anything real; the overlay is only ever visible
    // while the input is empty.
    var form = document.querySelector('[data-kzd-prompt-form]');
    if (!form) { return; }
    var input = form.querySelector('[data-kzd-prompt-input]');
    var overlay = form.querySelector('[data-kzd-prompt-typing]');
    var textEl = form.querySelector('[data-kzd-prompt-typing-text]');
    if (!input || !overlay || !textEl) { return; }

    var PHRASES = [
        'I want a boutique salon website named NockBeauty',
        'A coffee roastery in Durban with single-origin beans',
        'A SaaS billing platform for usage-based invoicing',
        'A law firm in Cape Town focused on labour law',
        'A seafood restaurant on the Cape Town waterfront'
    ];
    var TYPE_MS = 45, DELETE_MS = 25, HOLD_MS = 1500, GAP_MS = 400;
    var phraseIdx = 0, charIdx = 0, deleting = false, timeoutId = null;
    var reduceMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    function tick() {
        var phrase = PHRASES[phraseIdx];
        if (!deleting) {
            charIdx += 1;
            textEl.textContent = phrase.slice(0, charIdx);
            if (charIdx >= phrase.length) { timeoutId = setTimeout(function () { deleting = true; tick(); }, HOLD_MS); return; }
            timeoutId = setTimeout(tick, TYPE_MS);
        } else {
            charIdx -= 1;
            textEl.textContent = phrase.slice(0, charIdx);
            if (charIdx <= 0) {
                deleting = false;
                phraseIdx = (phraseIdx + 1) % PHRASES.length;
                timeoutId = setTimeout(tick, GAP_MS);
                return;
            }
            timeoutId = setTimeout(tick, DELETE_MS);
        }
    }

    function stop() {
        if (timeoutId) { clearTimeout(timeoutId); timeoutId = null; }
        overlay.hidden = true;
    }
    function start() {
        if (timeoutId || input.value) { return; }
        overlay.hidden = false;
        if (reduceMotion) { textEl.textContent = PHRASES[0]; return; }
        timeoutId = setTimeout(tick, 500);
    }

    input.addEventListener('input', function () { if (input.value) { stop(); } else { start(); } });
    start();
})();

(function () {
    // Example chips under the prompt bar ("Restaurant", "Consulting", ...)
    // -- clicking one fills the real input with that word and focuses it,
    // the same "tap a suggestion, see it land in the bar" pattern as the
    // AI Website Builder's own example prompts. Dispatches a real 'input'
    // event (not just setting .value) so the typing-placeholder IIFE above
    // sees it and hides its animated overlay exactly as if the visitor had
    // typed it themselves.
    /* The same first question the builder asks, mirrored here so obvious
       mash is caught before the page navigates -- it is cheaper to say so
       now than to hand it to /build and bounce them back. Only the cheap
       half: whether a real-but-short description is enough is decided in
       the builder, which is also where a prompt arriving by URL is judged. */
    function kzdLooksLikeTyping(text) {
        var t = (text || '').trim();
        if (!t) { return true; }
        var letters = t.match(/[a-z]/gi) || [];
        if (!letters.length) { return true; }
        var tokens = t.toLowerCase().split(/[^a-z]+/).filter(Boolean);
        if (tokens.some(function (w) {
            return /^(?:qwer|wert|erty|asdf|sdfg|dfgh|fghj|ghjk|hjkl|zxcv|xcvb|cvbn|1234|aaaa)/.test(w);
        })) { return true; }
        var judged = tokens.filter(function (w) { return w.length > 3; });
        var wordy = judged.filter(function (w) {
            return /[aeiouy]/.test(w) && !/[^aeiouy]{5,}/.test(w) && !/(.)\1\1/.test(w);
        });
        if (judged.length && wordy.length / judged.length < 0.5) { return true; }
        var vowels = (t.toLowerCase().match(/[aeiouy]/g) || []).length;
        return letters.length >= 10 && vowels / letters.length < 0.2;
    }

    var promptForms = document.querySelectorAll('[data-kzd-prompt-form], [data-kzd-pinned-prompt]');
    promptForms.forEach(function (form) {
        var field = form.querySelector('input[name="prompt"]');
        if (!field) { return; }
        var note = null;
        form.addEventListener('submit', function (ev) {
            if (!kzdLooksLikeTyping(field.value)) {
                if (note) { note.remove(); note = null; }
                return;
            }
            ev.preventDefault();
            if (!note) {
                note = document.createElement('p');
                note.className = 'kzd-prompt-note';
                note.setAttribute('role', 'alert');
                note.style.cssText = 'margin:10px 0 0;font-size:13px;font-weight:600;color:#B4431F;';
                form.insertAdjacentElement('afterend', note);
            }
            note.textContent = 'That does not look like a description yet. Tell me what the business does, where it is and what it is called.';
            field.focus();
        });
        field.addEventListener('input', function () { if (note) { note.remove(); note = null; } });
    });

    var chips = document.querySelectorAll('[data-kzd-example-chip]');
    if (!chips.length) { return; }
    var input = document.querySelector('[data-kzd-prompt-input]');
    if (!input) { return; }
    chips.forEach(function (chip) {
        chip.addEventListener('click', function () {
            input.value = chip.getAttribute('data-kzd-example-chip') || '';
            input.dispatchEvent(new Event('input', { bubbles: true }));
            input.focus();
        });
    });
})();

(function () {
    // Mobile nav panel — hamburger toggle for the collapsed header (see
    // kzd-mobile-toggle CSS above for why this exists). data-kzd-mobile-
    // close on a link/button closes the panel after it's used, so picking
    // a mega-menu trigger from here doesn't leave the panel sitting open
    // behind the overlay it just opened.
    var toggle = document.querySelector('[data-kzd-mobile-toggle]');
    var panel = document.querySelector('[data-kzd-mobile-panel]');
    if (!toggle || !panel) { return; }
    var openIcon = toggle.querySelector('[data-kzd-mobile-icon-open]');
    var closeIcon = toggle.querySelector('[data-kzd-mobile-icon-close]');
    function setOpen(open) {
        panel.hidden = !open;
        panel.classList.toggle('is-open', open);
        toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
        if (openIcon) { openIcon.style.display = open ? 'none' : ''; }
        if (closeIcon) { closeIcon.style.display = open ? '' : 'none'; }
    }
    toggle.addEventListener('click', function () { setOpen(panel.hidden); });
    panel.querySelectorAll('[data-kzd-mobile-close]').forEach(function (el) {
        el.addEventListener('click', function () { setOpen(false); });
    });
})();

(function () {
    // Nav mega-menu — three sections (how-it-works, hosting/pricing, why
    // KZD) that used to sit permanently in the page now live in one
    // overlay, shown only when their nav item is clicked. Only one panel
    // open at a time; clicking the already-open trigger, the close button,
    // the backdrop, or Escape all close it.
    var overlay = document.querySelector('[data-kzd-menu-overlay]');
    var backdrop = document.querySelector('[data-kzd-menu-backdrop]');
    var triggers = document.querySelectorAll('[data-kzd-menu-trigger]');
    var panels = document.querySelectorAll('[data-kzd-menu-panel]');
    var closeBtns = document.querySelectorAll('[data-kzd-menu-close]');
    if (!overlay || !backdrop || !triggers.length) { return; }

    function openPanel(name) {
        // The header (and this overlay, its sticky sibling) is only sticky
        // within its own containing block, which ends after the hero — a
        // trigger clicked from further down the page (the "View hosting
        // services" CTA) would otherwise open a panel that's scrolled
        // straight out of view along with the header. Scrolling to the
        // top first guarantees the panel that just opened is the panel
        // the visitor actually sees, regardless of where they clicked it.
        if (window.scrollY > 40) {
            window.scrollTo({ top: 0, behavior: 'auto' });
        }
        panels.forEach(function (p) { p.hidden = p.getAttribute('data-kzd-menu-panel') !== name; });
        triggers.forEach(function (t) { t.classList.toggle('is-active', t.getAttribute('data-kzd-menu-trigger') === name); });
        overlay.hidden = false;
        backdrop.hidden = false;
        overlay.scrollTop = 0;
        document.body.style.overflow = 'hidden';
        requestAnimationFrame(function () {
            overlay.classList.add('is-open');
            backdrop.classList.add('is-open');
        });
        var shownPanel = document.querySelector('[data-kzd-menu-panel="' + name + '"]');
        if (shownPanel && window.kzdReplayReveal) { window.kzdReplayReveal(shownPanel); }
    }

    function closeMenu() {
        overlay.classList.remove('is-open');
        backdrop.classList.remove('is-open');
        document.body.style.overflow = '';
        triggers.forEach(function (t) { t.classList.remove('is-active'); });
        window.setTimeout(function () {
            if (!overlay.classList.contains('is-open')) {
                overlay.hidden = true;
                backdrop.hidden = true;
            }
        }, 220);
    }

    triggers.forEach(function (btn) {
        btn.addEventListener('click', function () {
            var name = btn.getAttribute('data-kzd-menu-trigger');
            var alreadyOpen = btn.classList.contains('is-active') && overlay.classList.contains('is-open');
            if (alreadyOpen) { closeMenu(); } else { openPanel(name); }
        });
    });
    closeBtns.forEach(function (btn) { btn.addEventListener('click', closeMenu); });
    backdrop.addEventListener('click', closeMenu);
    document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' && overlay.classList.contains('is-open')) { closeMenu(); }
    });
})();

(function () {
    // Trimmed default TLD grid ("show only a few, more on request") — one
    // expand button reveals the rest inline, replaying the same reveal
    // animation the rest of the page uses instead of just snapping in.
    var triggers = document.querySelectorAll('[data-kzd-expand-trigger]');
    triggers.forEach(function (btn) {
        btn.addEventListener('click', function () {
            var name = btn.getAttribute('data-kzd-expand-trigger');
            var target = document.querySelector('[data-kzd-expand-target="' + name + '"]');
            if (!target) { return; }
            target.hidden = false;
            btn.hidden = true;
            if (window.kzdReplayReveal) { window.kzdReplayReveal(target); }
        });
    });
})();

(function () {
    var video = document.querySelector('.kzd-builder-video');
    var toggle = document.querySelector('[data-kzd-video-toggle]');
    if (!video || !toggle) { return; }

    var pauseIcon = toggle.querySelector('[data-kzd-icon-pause]');
    var playIcon = toggle.querySelector('[data-kzd-icon-play]');
    var reduceMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    function setPlaying(playing) {
        pauseIcon.style.display = playing ? '' : 'none';
        playIcon.style.display = playing ? 'none' : '';
        toggle.setAttribute('aria-label', playing ? 'Pause video' : 'Play video');
    }

    if (reduceMotion) {
        video.pause();
        video.removeAttribute('autoplay');
        setPlaying(false);
    }

    toggle.addEventListener('click', function () {
        if (video.paused) { video.play(); setPlaying(true); }
        else { video.pause(); setPlaying(false); }
    });
})();

(function () {
    var reduceMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (!('IntersectionObserver' in window) || reduceMotion) {
        document.querySelectorAll('.kzd-reveal, .kzd-reveal-card').forEach(function (el) { el.classList.add('is-visible'); });
        window.kzdReplayReveal = function () {};
        return;
    }

    var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (entry) {
            if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                io.unobserve(entry.target);
            }
        });
    }, { threshold: 0.15, rootMargin: '0px 0px -60px 0px' });

    document.querySelectorAll('.kzd-reveal, .kzd-reveal-card').forEach(function (el) { io.observe(el); });

    window.kzdReplayReveal = function (container) {
        var els = container.querySelectorAll('.kzd-reveal, .kzd-reveal-card');
        els.forEach(function (el) {
            io.unobserve(el);
            el.classList.remove('is-visible');
            void el.offsetWidth;
            requestAnimationFrame(function () { el.classList.add('is-visible'); });
        });
    };
})();

(function () {
    // The type bar under the coverflow. It reports which card is front and
    // centre; it does not drive anything.
    var strip = document.querySelector('[data-kzd-types]');
    var stage = document.querySelector('.kzd-coverflow-stage');
    if (!strip || !stage) { return; }
    var pills = [].slice.call(strip.querySelectorAll('[data-kzd-type-pill]'));
    var cards = [].slice.call(stage.querySelectorAll('.kzd-cf-card'));
    var notch = strip.querySelector('[data-kzd-types-notch]');
    var track = strip.querySelector('[data-kzd-types-tabs]');
    if (!pills.length || pills.length !== cards.length) { return; }

    var current = -1;
    var frame = null;

    function markCurrent(i) {
        if (i === current) { return; }
        current = i;
        pills.forEach(function (p, n) {
            if (n === i) { p.setAttribute('aria-current', 'true'); }
            else { p.removeAttribute('aria-current'); }
        });
        // Keep the active pill visible once the track scrolls on a phone.
        if (track.scrollWidth > track.clientWidth) {
            var p = pills[i];
            track.scrollTo({ left: p.offsetLeft - (track.clientWidth - p.offsetWidth) / 2, behavior: 'smooth' });
        }
    }

    // Position between two pills, so the notch travels with the cards rather
    // than jumping once they have already swapped.
    function placeNotch(from, to, t) {
        var a = pills[from], b = pills[to];
        var left = a.offsetLeft + (b.offsetLeft - a.offsetLeft) * t;
        var width = a.offsetWidth + (b.offsetWidth - a.offsetWidth) * t;
        notch.style.width = width + 'px';
        notch.style.transform = 'translateX(' + left + 'px)';
    }

    function syncEdges() {
        var scrollable = track.scrollWidth - track.clientWidth;
        track.classList.toggle('has-start', scrollable > 1 && track.scrollLeft > 1);
        track.classList.toggle('has-end', scrollable > 1 && track.scrollLeft < scrollable - 1);
    }

    // ---- desktop: the cards run on a CSS animation ----
    // Read ITS clock rather than running a matching timer. Two independent
    // clocks drift, and a drifting bar names the wrong card.
    function cardAnimation() {
        if (!cards[0].getAnimations) { return null; }
        var list = cards[0].getAnimations();
        for (var i = 0; i < list.length; i++) {
            if (list[i].animationName === 'kzd-cf-cycle' || (list[i].animationName || '').indexOf('kzd-cf') === 0) {
                return list[i];
            }
        }
        return list[0] || null;
    }

    var CYCLE = 19000;              // must match the kzd-cf-cycle duration
    var SLOT = CYCLE / 5;           // one card's turn at the front
    // From the keyframes: the outgoing card has finished leaving the middle at
    // 12% of the cycle (2280ms), and the next one lands on the slot boundary.
    // The notch travels only in that gap, so it never leaves a pill while that
    // pill's card is still on the centre line.
    var GONE = 2280 / SLOT;

    function ease(t) {
        // Eased both ends, so the notch sets off and arrives with the cards
        // rather than starting and stopping dead.
        return t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2;
    }

    function tick() {
        var anim = cardAnimation();
        if (!anim || anim.playState !== 'running') { frame = null; return; }
        var phase = (Number(anim.currentTime) || 0) % CYCLE;
        var slot = Math.floor(phase / SLOT) % pills.length;
        var u = (phase - slot * SLOT) / SLOT;
        var next = (slot + 1) % pills.length;
        var t = u <= GONE ? 0 : ease((u - GONE) / (1 - GONE));
        placeNotch(slot, next, t);
        markCurrent(t < 0.5 ? slot : next);
        frame = requestAnimationFrame(tick);
    }

    // ---- phone: the cards are a scroll-snap carousel ----
    function fromScroll() {
        var mid = stage.scrollLeft + stage.clientWidth / 2;
        var best = 0, bestD = Infinity;
        cards.forEach(function (c, i) {
            var d = Math.abs(c.offsetLeft + c.offsetWidth / 2 - mid);
            if (d < bestD) { bestD = d; best = i; }
        });
        markCurrent(best);
        placeNotch(best, best, 0);
    }

    function isScroller() { return stage.scrollWidth - stage.clientWidth > 4; }

    function start() {
        if (isScroller()) { fromScroll(); return; }
        if (frame === null) { frame = requestAnimationFrame(tick); }
    }
    function stop() {
        if (frame !== null) { cancelAnimationFrame(frame); frame = null; }
    }

    stage.addEventListener('scroll', function () { if (isScroller()) { fromScroll(); } }, { passive: true });
    track.addEventListener('scroll', syncEdges, { passive: true });

    // No work while the strip is off screen.
    if ('IntersectionObserver' in window) {
        new IntersectionObserver(function (entries) {
            entries.forEach(function (e) { if (e.isIntersecting) { start(); } else { stop(); } });
        }, { threshold: 0 }).observe(stage);
    } else {
        start();
    }

    window.addEventListener('resize', function () { stop(); syncEdges(); start(); }, { passive: true });
    // Web fonts land after first paint and change every pill's width, so the
    // notch is re-measured once they do instead of keeping fallback metrics.
    if (document.fonts && document.fonts.ready) {
        document.fonts.ready.then(function () { syncEdges(); if (isScroller()) { fromScroll(); } });
    }
    markCurrent(0);
    placeNotch(0, 0, 0);
    syncEdges();
    start();
})();

(function () {
    // Billing toggle. Both figures are already on the element as data
    // attributes, so switching is a text swap with no request -- and with
    // JS off the page still shows real monthly prices rather than blanks.
    var root = document.querySelector('[data-kzd-plans]');
    if (!root) { return; }
    var buttons = [].slice.call(root.querySelectorAll('[data-kzd-period]'));
    if (!buttons.length) { return; }

    function show(period) {
        buttons.forEach(function (b) {
            b.setAttribute('aria-pressed', b.getAttribute('data-kzd-period') === period ? 'true' : 'false');
        });
        var key = period.toLowerCase();
        root.querySelectorAll('[data-kzd-price]').forEach(function (el) {
            var v = el.getAttribute('data-price-' + key);
            if (v !== null) { el.textContent = v; }
        });
        root.querySelectorAll('[data-kzd-billed]').forEach(function (el) {
            el.textContent = el.getAttribute('data-billed-' + key) || '';
        });
        // The unit changes with the period: a yearly card says /year.
        root.querySelectorAll('[data-kzd-per]').forEach(function (el) {
            var v = el.getAttribute('data-per-' + key);
            if (v !== null) { el.textContent = v; }
        });
        // The saving claim belongs to the term, so it changes with it -- and
        // is empty on monthly, where there is nothing to claim.
        var saving = root.querySelector('[data-kzd-saving]');
        if (saving) { saving.textContent = saving.getAttribute('data-saving-' + key) || ''; }
    }

    buttons.forEach(function (b) {
        b.addEventListener('click', function () { show(b.getAttribute('data-kzd-period')); });
    });

    // Paint the starting state from the same attributes the clicks use, so
    // the first render cannot disagree with every later one.
    show('1M');

})();

// The #templates-strip coverflow (see .kzd-coverflow-stage CSS) runs on
// pure CSS @keyframes now -- no JS needed here at all.
</script>
{% endif %}
{% endblock %}

{% extends request.ajax ? "layout_blank.html.twig" : "layout_default.html.twig" %}
{% set active_menu = 'order' %}

{% block meta_title %}{{ 'Order'|trans }} - {{ product.title }}{% endblock %}

{% block body_class %}order-product{% endblock %}
{% block breadcrumb %}
    <li class="active breadcrumb-item" aria-current="page">{{ 'Order'|trans }} - {{ product.title }}</li>
{% endblock %}
{% block content_before %}{% endblock %}

{# KZD Solutions: same "Order" title / slim-header treatment as the
   mod_order_index.html.twig override, kept consistent since this template
   renders the identical orderbutton flow for a pre-selected product
   (arrived via /order/:id or /order/:slug) -- see mod_order_index.html.twig
   for the full rationale. #}
{% block content %}
    <div class="row">
        <div class="col-md-12">
            {# data-bs-theme="light" — see mod_order_index.html.twig for
               why: the redesigned order flow was built with hardcoded
               light backgrounds and never given dark-mode contrast
               pairs, so it's pinned to light mode regardless of the
               site-wide toggle. #}
            <div class="card mb-4 kzd-order-page-card" data-bs-theme="light">
                <div class="card-header py-3 kzd-order-page-header">
                    <div class="d-flex justify-content-between align-items-center">
                        <div class="w-100">
                            <h1 class="mb-1">{{ 'Order'|trans }}</h1>
                            {{ include('mod_orderbutton_currency.html.twig') }}
                        </div>
                    </div>
                </div>
                <div class="card-body overflow-hidden">
                    {{ include('mod_orderbutton_content.html.twig') }}
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block sidebar2 %}
    {{ include('partial_currency.html.twig') }}
{% endblock %}

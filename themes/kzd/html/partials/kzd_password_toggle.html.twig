{#
  KZD Solutions addition: every password field in this theme was rendered
  with type="password" and no way to reveal it -- fine for privacy while
  typing, but a real problem if someone mistypes and can't tell what they
  actually entered before submitting (relevant across login, signup, the
  Google-account-link password-confirm page, the set-new-password page,
  and the profile/hosting password fields).

  Generic, theme-level fix rather than editing every template individually:
  finds every input[type="password"] on the page after load and adds a
  show/hide toggle button next to it. Covers current and future password
  fields (including stock Client-module templates this theme doesn't
  override, e.g. profile/set-new-password) without touching each one.

  Included from both layout_default.html.twig and layout_public.html.twig,
  same reasoning as kzd_modals.html.twig -- checkout/order pages extend
  layout_public, not layout_default.
#}
<script>
(function () {
    var EYE_ICON = '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>';
    var EYE_OFF_ICON = '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17.94 17.94A10.94 10.94 0 0 1 12 20c-7 0-11-8-11-8a20.3 20.3 0 0 1 5.06-6.06M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a20.32 20.32 0 0 1-3.22 4.47M14.12 14.12a3 3 0 1 1-4.24-4.24"></path><line x1="1" y1="1" x2="23" y2="23"></line></svg>';
    var SHOW_LABEL = {{ 'Show password'|trans|json_encode|raw }};
    var HIDE_LABEL = {{ 'Hide password'|trans|json_encode|raw }};

    function wrapPasswordField(input) {
        if (input.closest('.kzd-password-wrap') || input.dataset.kzdNoToggle !== undefined) {
            return;
        }

        var wrap = document.createElement('div');
        wrap.className = 'input-group kzd-password-wrap';
        input.parentNode.insertBefore(wrap, input);
        wrap.appendChild(input);

        var btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'btn btn-outline-secondary kzd-password-toggle';
        btn.setAttribute('aria-label', SHOW_LABEL);
        btn.innerHTML = EYE_ICON;

        btn.addEventListener('click', function () {
            var willShow = input.type === 'password';
            input.type = willShow ? 'text' : 'password';
            btn.setAttribute('aria-label', willShow ? HIDE_LABEL : SHOW_LABEL);
            btn.innerHTML = willShow ? EYE_OFF_ICON : EYE_ICON;
        });

        wrap.appendChild(btn);
    }

    function wrapAll() {
        document.querySelectorAll('input[type="password"]').forEach(wrapPasswordField);
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', wrapAll);
    } else {
        wrapAll();
    }
})();
</script>

{% extends "layout_public.html.twig" %}

{% block meta_title %}{{ 'Login'|trans }}{% endblock %}
{% block meta_description %}{{ 'Log in to manage your services, invoices, support tickets, and account details.'|trans }}{% endblock %}

{% block body_class %}page-login{% endblock %}
{% block body %}
<div class="kzd-auth-wrapper">
    {{ include('partial_auth_panel.html.twig') }}
    <div class="kzd-auth-form-side">
        <div class="kzd-auth-form-inner">
            {% if (public_logo_url or public_dark_logo_url) and settings.login_page_show_logo %}
                <div class="d-flex justify-content-center d-lg-none">
                    {{ include('partial_company_logo.html.twig', {
                        company: company,
                        logo_url: public_logo_url,
                        dark_logo_url: public_dark_logo_url,
                        link_url: settings.login_page_logo_url|default('/'),
                        link_target: '_blank',
                        link_rel: 'noopener noreferrer',
                        image_class: 'my-4',
                        image_height: '50px'
                    }) }}
                </div>
            {% endif %}
            <div class="card">
                <div class="card-body">
                    <h5 class="text-center m-4">{{ 'Login to Your Account'|trans }}</h5>
                    {{ render_widgets('client.page.login.form.before') }}
                    {% set effective_redirect_uri = request_query.redirect_uri|default(redirect_uri|default('/')) %}
                    <form method="post" action="{{ 'client/login'|api_url(role: 'guest') }}" class="auth" {{ fb_api_form({redirect: effective_redirect_uri|url}) }}>
                        <div class="mb-3">
                            <label class="form-label" for="email">{{ 'Email'|trans }}</label>
                            <input class="form-control" id="email" type="email" placeholder="{{ 'Enter your email address'|trans }}" name="email" value="{{ request.email }}" required="required" autofocus>
                        </div>
                        <div class="mb-3">
                            <label class="form-label" for="password">{{ 'Password'|trans }}</label>
                            <input class="form-control" id="password" type="password" placeholder="{{ 'Enter your password'|trans }}" name="password" required="required">
                        </div>
                        <button type="submit" class="btn btn-primary w-100 mb-3">{{ 'Login'|trans }}</button>
                    </form>
                    {{ render_widgets('client.page.login.form.after') }}
                    {% if guest.client_google_oauth_enabled %}
                        <div class="d-flex align-items-center gap-2 my-3">
                            <hr class="flex-grow-1 my-0">
                            <span class="text-secondary small">{{ 'or'|trans }}</span>
                            <hr class="flex-grow-1 my-0">
                        </div>
                        <a class="btn btn-outline-secondary w-100 mb-3 d-flex align-items-center justify-content-center gap-2"
                           href="{{ 'client/oauth/google/start'|url }}{% if effective_redirect_uri and effective_redirect_uri != '/' %}?redirect_uri={{ effective_redirect_uri|url_encode }}{% endif %}">
                            <svg width="18" height="18" viewBox="0 0 48 48" aria-hidden="true" focusable="false">
                                <path fill="#FFC107" d="M43.6 20.5H42V20H24v8h11.3C33.9 32.9 29.4 36 24 36c-6.6 0-12-5.4-12-12s5.4-12 12-12c3.1 0 5.8 1.1 8 3l5.7-5.7C34.6 6.1 29.6 4 24 4 12.9 4 4 12.9 4 24s8.9 20 20 20 20-8.9 20-20c0-1.3-.1-2.7-.4-3.5z"/>
                                <path fill="#FF3D00" d="M6.3 14.7l6.6 4.8C14.6 15.9 18.9 13 24 13c3.1 0 5.8 1.1 8 3l5.7-5.7C34.6 6.1 29.6 4 24 4c-7.4 0-13.7 4.2-16.9 10.3z"/>
                                <path fill="#4CAF50" d="M24 44c5.3 0 10.2-2 13.9-5.4l-6.4-5.4C29.4 34.9 26.8 36 24 36c-5.3 0-9.8-3.1-11.3-7.6l-6.6 5.1C9.1 39.7 15.9 44 24 44z"/>
                                <path fill="#1976D2" d="M43.6 20.5H42V20H24v8h11.3c-.9 2.6-2.6 4.8-4.8 6.4l6.4 5.4C40.1 36.6 44 30.8 44 24c0-1.3-.1-2.7-.4-3.5z"/>
                            </svg>
                            {{ 'Continue with Google'|trans }}
                        </a>
                    {% endif %}
                    {% if settings.show_password_reset_link or settings.show_signup_link %}
                        <div class="row">
                            {% if settings.show_signup_link %}
                                <div class="col">
                                    <a class="btn btn-outline-primary mb-2 w-100" href="{{ 'signup'|url }}{% if effective_redirect_uri and effective_redirect_uri != '/' %}?redirect_uri={{ effective_redirect_uri|url_encode }}{% endif %}">{{ 'Create Account'|trans }}</a>
                                </div>
                            {% endif %}
                            {% if settings.show_password_reset_link %}
                                <div class="col">
                                    <a class="btn btn-outline-primary mb-2 w-100" href="{{ 'password-reset'|url }}">{{ 'Forgot Password?'|trans }}</a>
                                </div>
                            {% endif %}
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% extends "layout_public.html.twig" %}

{% import "macro_functions.html.twig" as mf %}

{% block meta_title %}{{ 'Register'|trans }}{% endblock %}
{% block meta_description %}{{ 'Create an account to order services, manage billing, and track support requests online.'|trans }}{% endblock %}

{% block body_class %}page-signup{% endblock %}
{% block body %}
<div class="kzd-auth-wrapper">
    <div class="kzd-auth-form-side">
        <div class="kzd-auth-back-link kzd-auth-back-link-wide">
            <a href="{{ settings.kzd_site_url|default('https://kzdsolutions.co.za') }}"><svg class="icon"><use href="#chevron-left" /></svg>{{ 'Back to homepage'|trans }}</a>
        </div>
        <div class="kzd-auth-form-inner kzd-auth-form-inner-wide">
            {% if (public_logo_url or public_dark_logo_url) and settings.login_page_show_logo %}
                <div class="d-flex justify-content-center kzd-auth-logo-row">
                    {{ include('partial_company_logo.html.twig', {
                        company: company,
                        logo_url: public_logo_url,
                        dark_logo_url: public_dark_logo_url,
                        link_url: settings.login_page_logo_url|default(settings.kzd_site_url|default('https://kzdsolutions.co.za')),
                        image_class: 'my-4',
                        image_height: '50px'
                    }) }}
                </div>
            {% endif %}
            <div class="card">
                <div class="card-body">
                    <h5 class="text-center m-4">{{ 'Create your account'|trans }}</h5>
                    {% set effective_redirect_uri = request_query.redirect_uri|default('/') %}
                    {# Shown once a Client ID + Secret are saved under Client settings >
                       Google Sign-In; until then client/oauth/google/start would only
                       bounce the visitor to the login page. #}
                    {% if guest.client_google_oauth_enabled %}
                        <a class="btn btn-outline-secondary kzd-google-btn w-100 mb-3" href="{{ 'client/oauth/google/start'|url }}{% if effective_redirect_uri and effective_redirect_uri != '/' %}?redirect_uri={{ effective_redirect_uri|url_encode }}{% endif %}">
                            <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true">
                                <path fill="#4285F4" d="M17.64 9.2c0-.637-.057-1.251-.164-1.84H9v3.481h4.844a4.14 4.14 0 0 1-1.796 2.716v2.259h2.908c1.702-1.567 2.684-3.874 2.684-6.615z"/>
                                <path fill="#34A853" d="M9 18c2.43 0 4.467-.806 5.956-2.18l-2.908-2.259c-.806.54-1.837.86-3.048.86-2.344 0-4.328-1.584-5.036-3.711H.957v2.332A8.997 8.997 0 0 0 9 18z"/>
                                <path fill="#FBBC05" d="M3.964 10.71A5.41 5.41 0 0 1 3.682 9c0-.593.102-1.17.282-1.71V4.958H.957A8.996 8.996 0 0 0 0 9c0 1.452.348 2.827.957 4.042l3.007-2.332z"/>
                                <path fill="#EA4335" d="M9 3.58c1.321 0 2.508.454 3.44 1.345l2.582-2.58C13.463.891 11.426 0 9 0A8.997 8.997 0 0 0 .957 4.958L3.964 7.29C4.672 5.163 6.656 3.58 9 3.58z"/>
                            </svg>
                            {{ 'Continue with Google'|trans }}
                        </a>
                        <div class="kzd-auth-divider"><span>{{ 'or fill in your details'|trans }}</span></div>
                    {% endif %}
                    <form method="post" action="{{ 'client/create'|api_url(role: 'guest') }}" class="auth" {{ fb_api_form({redirect: effective_redirect_uri|url}) }}>
                        {% set r = guest.client_required %}

                        <div class="kzd-form-section-label">{{ 'Your details'|trans }}</div>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label" for="first-name">{{ 'First name'|trans }}</label>
                                <input class="form-control" id="first-name" type="text" name="first_name" autocomplete="given-name"
                                       value="{{ request.first_name }}" required="required"/>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label class="form-label" for="last_name">{{ 'Last name'|trans }}</label>
                                <input class="form-control" id="last_name" type="text" name="last_name" autocomplete="family-name"
                                       value="{{ request.last_name }}"{% if 'last_name' in r %} required="required"{% endif %}/>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label" for="reg-email">{{ 'Email address'|trans }}</label>
                            <input class="form-control" id="reg-email" type="email" inputmode="email" spellcheck="false" placeholder="{{ 'name@company.com…'|trans }}" name="email" autocomplete="email"
                                   value="{{ request.email }}" required="required"/>
                        </div>

                        {% set has_more_details = 'company' in r or 'birthday' in r or 'gender' in r or 'address_1' in r or 'address_2' in r or 'city' in r or 'country' in r or 'state' in r or 'postcode' in r or 'phone' in r %}
                        {% if has_more_details %}
                            <div class="kzd-form-section-label kzd-form-section-label-spaced">{{ 'A few more details'|trans }}</div>
                        {% endif %}

                        {% if 'company' in r %}
                            <div class="mb-3">
                                <label class="form-label" for="company">{{ 'Company'|trans }}</label>
                                <input class="form-control" id="company" type="text" name="company"
                                       value="{{ request.company }}" required="required"/>
                            </div>
                        {% endif %}

                        {% if 'birthday' in r %}
                            <div class="mb-3">
                                <label class="form-label" for="birthday">{{ 'Birthday'|trans }}</label>
                                <input class="form-control" id="birthday" type="date" name="birthday" value=""/>
                            </div>
                        {% endif %}

                        {% if 'gender' in r %}
                            <div class="mb-3">
                                <label class="form-label" for="gender">{{ 'Gender'|trans }}</label>
                                <select class="form-select" id="gender" name="gender">
                                    <option value="male">{{ 'Male'|trans }}</option>
                                    <option value="female">{{ 'Female'|trans }}</option>
                                    <option value="nonbinary">{{ 'Non-binary'|trans }}</option>
                                    <option value="other">{{ 'Other'|trans }}</option>
                                </select>
                            </div>
                        {% endif %}

                        {% if 'address_1' in r %}
                            <div class="mb-3">
                                <label class="form-label" for="address_1">{{ 'Address'|trans }}</label>
                                <input class="form-control" id="address_1" type="text" name="address_1"
                                       value="{{ request.address_1 }}"/>
                            </div>
                        {% endif %}

                        {% if 'address_2' in r %}
                            <div class="mb-3">
                                <label class="form-label" for="address_2">{{ 'Address 2'|trans }}</label>
                                <input class="form-control" id="address_2" type="text" name="address_2"
                                       value="{{ request.address_2 }}"/>
                            </div>
                        {% endif %}

                        {% if 'city' in r %}
                            <div class="mb-3">
                                <label class="form-label" for="city">{{ 'City'|trans }}</label>
                                <input class="form-control" id="city" type="text" name="city"
                                       value="{{ request.city }}"/>
                            </div>
                        {% endif %}

                        {% if 'country' in r %}
                            <div class="mb-3">
                                <label class="form-label" for="country">{{ 'Country'|trans }}</label>
                                <select class="form-select" id="country" name="country" required="required">
                                    <option value="">{{ '-- Select Country --'|trans }}</option>
                                    {% for val,label in guest.system_countries %}
                                        <option value="{{ val }}" label="{{ label|e }}" {% if request.country|default(guest.system_default_country) == val %}selected{% endif %}>{{ label|e }}</option>
                                    {% endfor %}
                                </select>
                            </div>
                        {% endif %}

                        {% if 'state' in r %}
                            <div class="mb-3">
                                <label class="form-label" for="state">{{ 'State'|trans }}</label>
                                <input class="form-control" id="state" type="text" name="state"
                                       value="{{ request.state }}"/>
                            </div>
                        {% endif %}

                        {% if 'postcode' in r %}
                            <div class="mb-3">
                                <label class="form-label" for="postcode">{{ 'Zip/Postal Code'|trans }}</label>
                                <input class="form-control" id="postcode" type="text" name="postcode"
                                       value="{{ request.postcode }}"/>
                            </div>
                        {% endif %}

                        {% if 'phone' in r %}
                            <div class="mb-3">
                                <label class="form-label" for="phone">{{ 'Phone Number'|trans }}</label>
                                <input type="hidden" id="phone_cc" name="phone_cc" value="{{ request.phone_cc }}">
                                <input class="form-control js-phone-input" id="phone" type="tel" name="phone" value="{{ request.phone }}" autocomplete="tel" data-initial-country="{{ request.country|default(guest.system_default_country)|lower }}" required="required"/>
                            </div>
                        {% endif %}

                        <div class="mb-3">
                            <label class="form-label" for="reg-timezone">{{ 'Timezone'|trans }}</label>
                            <select class="form-select" id="reg-timezone" name="timezone" data-timezone-select>
                                <option value="">{{ '-- Use system default --'|trans }}</option>
                                {% for region, identifiers in guest.system_timezones %}
                                    <optgroup label="{{ region }}">
                                        {% for identifier in identifiers %}
                                            <option value="{{ identifier }}" {% if request.timezone|default('') == identifier %}selected="selected"{% endif %}>{{ identifier }}</option>
                                        {% endfor %}
                                    </optgroup>
                                {% endfor %}
                            </select>
                            <small class="form-hint text-muted">{{ 'Pre-selected from your browser. Used to display dates and times in your local time.'|trans }}</small>
                        </div>

                        {% set custom_fields = guest.client_custom_fields %}
                        {% for field_name, field in custom_fields %}
                            {% if field.active|default(false) %}
                                <div class="mb-3">
                                    <label class="form-label"
                                           for="{{ field_name }}">{{ field.title is not empty ? field.title : field_name|capitalize }}</label>
                                    <input class="form-control" id="{{ field_name }}" type="text"
                                           name="{{ field_name }}" value="{{ request.(field_name) }}"
                                           {% if field.required|default(false) %}required="required"{% endif %} />
                                </div>
                            {% endif %}
                        {% endfor %}

{% set honeypot = antispam_honeypot() %}
{% if honeypot.enabled %}
{% set honeypot_field = honeypot.field %}
<div class="mb-3" style="position: absolute; left: -9999px;">
<label class="form-label" for="{{ honeypot_field }}">{{ honeypot_field }}</label>
<input class="form-control" id="{{ honeypot_field }}" type="text" name="{{ honeypot_field }}" value="" tabindex="-1" autocomplete="off"/>
</div>
{% endif %}

<div class="kzd-form-section-label kzd-form-section-label-spaced">{{ 'Set a password'|trans }}</div>
<div class="mb-2">
<label class="form-label" for="reg-password">{{ 'Password'|trans }}</label>
                            <div class="kzd-password-field">
                                <input class="form-control" id="reg-password" type="password" name="password" value="" autocomplete="new-password"
                                       required="required"/>
                                <button type="button" class="kzd-password-toggle" data-kzd-password-toggle="reg-password" aria-label="{{ 'Show password'|trans }}">
                                    <svg class="icon" style="width: 17px; height: 17px;"><use href="#lock" /></svg>
                                </button>
                            </div>
                        </div>
                        <p class="form-hint mb-3">{{ 'At least 8 characters, with an uppercase letter, a lowercase letter, and a number.'|trans }}</p>

                        <div class="mb-3">
                            <label class="form-label" for="password-confirm">{{ 'Confirm password'|trans }}</label>
                            <div class="kzd-password-field">
                                <input class="form-control" id="password-confirm" type="password" name="password_confirm" value="" autocomplete="new-password" required="required"/>
                                <button type="button" class="kzd-password-toggle" data-kzd-password-toggle="password-confirm" aria-label="{{ 'Show password'|trans }}">
                                    <svg class="icon" style="width: 17px; height: 17px;"><use href="#lock" /></svg>
                                </button>
                            </div>
                        </div>

                        {{ mf.recaptcha }}

                        {% if settings.signup_tos|default('0') == 'explicit' %}
                            <div class="form-check mb-1">
                                <input class="form-check-input" type="checkbox" value="" id="flexCheckDefault" required>
                                <label class="form-check-label" for="flexCheckDefault">
                                    {# TODO: Make this translatable once support for placeholders is implemented #}
                                    <span>I agree to the <a href="{{ 'tos'|url }}" target="_blank">{{ 'Terms of Service'|trans }}</a> and <a href="{{ 'privacy-policy'|url }}" target="_blank">{{ 'Privacy Policy'|trans }}</a>.</span>
                                </label>
                            </div>
                        {% endif %}

                        <div class="form-actions mb-3">
                            <button class="btn btn-primary kzd-btn-gradient w-100" type="submit">{{ 'Create account'|trans }}</button>
                        </div>

                        {% if settings.signup_tos|default('0') == 'implicit' %}
                            <div class="mb-1">
                                {# TODO: Make this translatable once support for placeholders is implemented #}
                                <span class="text-muted mb-1">By creating an account, you agree to our <a href="{{ 'tos'|url }}" target="_blank">{{ 'Terms of Service'|trans }}</a> and <a href="{{ 'privacy-policy'|url }}" target="_blank">{{ 'Privacy Policy'|trans }}</a>.</span>
                            </div>
                        {% endif %}
                    </form>
                    <div class="kzd-auth-links">
                        <span>{{ 'Already have an account?'|trans }} <a href="{{ 'login'|url }}{% if effective_redirect_uri and effective_redirect_uri != '/' %}?redirect_uri={{ effective_redirect_uri|url_encode }}{% endif %}">{{ 'Log in'|trans }}</a></span>
                        {% if settings.show_password_reset_link %}
                            <a href="{{ 'password-reset'|url }}">{{ 'Forgot password?'|trans }}</a>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>
        <div class="kzd-auth-footer-note kzd-auth-footer-note-wide">
            <span><svg class="icon"><use href="#lock" /></svg>{{ 'Secure connection · Hosted in South Africa'|trans }}</span>
            <a href="{{ 'support/contact-us'|url }}">{{ 'Need help?'|trans }}</a>
        </div>
    </div>
</div>
{% endblock %}

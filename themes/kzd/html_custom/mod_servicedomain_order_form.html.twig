{#
  KZD Solutions redesign of the domain register/transfer form — HostAfrica-
  style search bar + clean result row instead of a bare Bootstrap form.

  IMPORTANT: every id/name/class the embedded <script> (below) or the
  sibling addons/checkout templates reference is preserved exactly
  (#domain-check, #transfer-check, input[name=register_sld], etc.) — only
  the surrounding markup/classes changed. Do not rename any of those
  without also updating the script block and mod_orderbutton_addons.html.twig.
#}
{% set periods = guest.system_periods %}
{% set pricing = product.pricing %}
{% set transfer_tlds = guest.serviceDomain_tlds({ "allow_transfer": 1 }) %}
{% set tlds = guest.serviceDomain_tlds({"allow_register":1}) %}

{% if tlds is not empty and transfer_tlds is not empty %}
    <div class="kzd-domain-tabs" role="tablist">
        <button type="button" class="kzd-domain-tab active" id="register-tab" data-bs-toggle="tab" data-bs-target="#register-tab-pane" role="tab" aria-controls="register-tab-pane">{{ 'Register a domain'|trans }}</button>
        <button type="button" class="kzd-domain-tab" id="transfer-tab" data-bs-toggle="tab" data-bs-target="#transfer-tab-pane" role="tab" aria-controls="transfer-tab-pane">{{ 'Transfer a domain'|trans }}</button>
    </div>
{% endif %}

<div class="tab-content">
    {% if tlds is not empty %}
        <div class="tab-pane show active" id="register-tab-pane" role="tabpanel" aria-labelledby="register-tab" tabindex="0">
            <div class="kzd-domain-search-row">
                <div class="kzd-domain-search-field">
                    <svg class="icon"><use href="#search" /></svg>
                    {# One field for the whole domain; no extension dropdown. The
                       hidden register_sld / register_tld below are what the form
                       and the checks read -- build/js/kzd-domain-input.js splits
                       what was typed into them. The home page's search sends both
                       halves; an extension card sends only register_tld, which
                       becomes the placeholder's ending. #}
                    <input class="kzd-domain-search-input" type="text" id="kzd-register-domain"
                        value="{{ request.register_sld ? request.register_sld ~ request.register_tld : '' }}"
                        placeholder="{{ 'yourbusiness'|trans }}{{ request.register_tld ?: '.co.za' }}"
                        aria-label="{{ 'Domain name, including its ending'|trans }}"
                        autocomplete="off" autocapitalize="off" spellcheck="false">
                    <input type="hidden" name="register_sld" value="{{ request.register_sld }}">
                    <input type="hidden" name="register_tld" value="{{ request.register_tld }}">
                </div>
                <button class="kzd-domain-search-btn" type="button" id="domain-check">{{ 'Search'|trans }}</button>
            </div>
            <div id="domain-check-error" class="kzd-domain-error" style="display:none;"></div>

            <div class="onAfterDomainCheck kzd-domain-result" style="display:none;">
                <div class="kzd-domain-result-row">
                    <div class="kzd-domain-result-info">
                        <span class="kzd-domain-result-badge">{{ 'Available'|trans }}</span>
                        <span class="kzd-domain-result-name" id="domain-name"></span>
                    </div>
                    <label class="kzd-domain-years">
                        <span>{{ 'Register for'|trans }}</span>
                        <select class="form-select form-select-sm" name="register_years" id="registration-years"></select>
                    </label>
                </div>
                <label class="kzd-domain-ns-toggle">
                    <input class="form-check-input" type="checkbox" role="switch" id="nameserversCb">
                    <span>{{ 'I want to use my own nameservers'|trans }}</span>
                </label>
                <div id="nameservers" class="kzd-domain-ns-grid" style="display:none;">
                    <input class="form-control form-control-sm" type="text" name="ns1" value="" placeholder="{{ 'Nameserver 1'|trans }}"/>
                    <input class="form-control form-control-sm" type="text" name="ns2" value="" placeholder="{{ 'Nameserver 2'|trans }}"/>
                    <input class="form-control form-control-sm" type="text" name="ns3" value="" placeholder="{{ 'Nameserver 3'|trans }}"/>
                    <input class="form-control form-control-sm" type="text" name="ns4" value="" placeholder="{{ 'Nameserver 4'|trans }}"/>
                </div>
            </div>
        </div>
    {% endif %}
    {% if transfer_tlds is not empty %}
        <div class="tab-pane {% if tlds is empty %} show active {% endif %}" id="transfer-tab-pane" role="tabpanel" aria-labelledby="transfer-tab" tabindex="0">
            <div class="kzd-domain-search-row">
                <div class="kzd-domain-search-field">
                    <svg class="icon"><use href="#search" /></svg>
                    <input class="kzd-domain-search-input" type="text" id="kzd-transfer-domain"
                           value="{{ request.transfer_sld ? request.transfer_sld ~ request.transfer_tld : '' }}"
                           placeholder="{{ 'yourbusiness.co.za'|trans }}"
                           aria-label="{{ 'Domain to transfer, including its ending'|trans }}"
                           autocomplete="off" autocapitalize="off" spellcheck="false">
                    <input type="hidden" name="transfer_sld" value="{{ request.transfer_sld }}">
                    <input type="hidden" name="transfer_tld" value="{{ request.transfer_tld }}">
                </div>
                <button class="kzd-domain-search-btn" type="button" id="transfer-check">{{ 'Search'|trans }}</button>
            </div>
            <div id="transfer-check-error" class="kzd-domain-error" style="display:none;"></div>
            <div id="domain-transfer-config" class="kzd-domain-result" style="display:none;">
                <div class="kzd-domain-result-row">
                    <div class="kzd-domain-result-info">
                        <span class="kzd-domain-result-badge">{{ 'Transferable'|trans }}</span>
                        <span class="kzd-domain-result-name" id="domain-name"></span>
                    </div>
                    <span class="kzd-domain-transfer-price">{{ 'Transfer price'|trans }}: <strong id="transfer-price"></strong></span>
                </div>
                <input class="kzd-domain-epp-input" type="text" name="transfer_code" value="{{ request.transfer_code }}"
                       placeholder="{{ 'Authorization/EPP code (optional)'|trans }}">
                <p class="kzd-domain-epp-hint">
                    {{ 'Most domains have a secret authorization code (EPP code) from their current registrar. If you have it, add it here to speed things up -- if not, no problem, we\'ll help you get the transfer moving after you order.'|trans }}
                </p>
            </div>
        </div>
    {% endif %}
</div>

<input type="hidden" name="id" value="{{ product.id }}"/>
<input type="hidden" name="action" value="register" id="domain-action"/>

{% set currency = guest.cart_get_currency %}
<script type="text/javascript">
    // Each ending with its real yearly registration price, for the
    // "try another ending" list shown when a name is taken.
    const kzdTldPrices = [{% for tld in tlds %}{ tld: "{{ tld.tld }}", price: {{ (tld.price_registration * currency.conversion_rate)|number_format(2, '.', '') }} }{% if not loop.last %}, {% endif %}{% endfor %}];
    const kzdCurrencyCode = "{{ currency.code }}";
    function fadeIn(el) {
        el.style.removeProperty('display');
        el.style.opacity = '0';
        el.style.transition = 'opacity 0.15s ease-in';
        requestAnimationFrame(() => el.style.opacity = '1');
    }

    function slideDown(el) {
        el.style.removeProperty('display');
        el.style.overflow = 'hidden';
        el.style.height = '0';
        el.style.transition = 'height 0.2s ease-out';
        requestAnimationFrame(() => el.style.height = el.scrollHeight + 'px');
    }

    const kzdRegisterableTlds = [{% for tld in tlds %}"{{ tld.tld }}"{% if not loop.last %}, {% endif %}{% endfor %}];
    const kzdTransferableTlds = [{% for tld in transfer_tlds %}"{{ tld.tld }}"{% if not loop.last %}, {% endif %}{% endfor %}];

    document.addEventListener('DOMContentLoaded', function () {
        document.querySelectorAll('ul.nav.nav-tabs > li.domain-tab a').forEach(a => {
            a.addEventListener('click', function () {
                document.getElementById('domain-action').value = this.getAttribute('rel');
            });
        });

        const configNext = document.getElementById('config-next');
        configNext.style.display = 'none';
        configNext.disabled = true;

        const addons = document.querySelector('.addons');
        if (addons) {
            const orderButton = document.querySelector('.order-button');
            if (orderButton) {
                orderButton.addEventListener('click', function () {
                    this.style.display = 'none';
                    slideDown(addons);
                    return false;
                });
            }
        }

        document.querySelectorAll('.addon-period-selector').forEach(el => {
            el.addEventListener('change', function () {
                const r = this.getAttribute('rel');
                const spans = document.querySelectorAll('#' + r + ' span');
                spans.forEach(span => span.style.display = 'none');
                const visibleSpan = document.querySelector('#' + r + ' span.' + this.value);
                if (visibleSpan) {
                    fadeIn(visibleSpan);
                }
            });
            el.dispatchEvent(new Event('change'));
        });

        const formatCurrency = (price, rate, code, multiply) => {
            let total = parseFloat(price) * parseFloat(rate);
            if (typeof multiply !== 'undefined') {
                total *= multiply;
            }
            return new Intl.NumberFormat(undefined, {
                style: 'currency',
                currency: code,
                currencyDisplay: 'narrowSymbol',
            }).format(total);
        };

        // The typed domain is split into the hidden name/extension fields.
        const registerVisible = document.getElementById('kzd-register-domain');
        const transferVisible = document.getElementById('kzd-transfer-domain');
        if (window.KZDDomain) {
            window.KZDDomain.bind(registerVisible, document.querySelector('input[name="register_sld"]'), document.querySelector('input[name="register_tld"]'), kzdRegisterableTlds);
            window.KZDDomain.bind(transferVisible, document.querySelector('input[name="transfer_sld"]'), document.querySelector('input[name="transfer_tld"]'), kzdTransferableTlds);
        }
        [registerVisible, transferVisible].forEach(function (el) {
            if (!el) return;
            // Enter runs the search, as the button does.
            el.addEventListener('keydown', function (e) {
                if (e.key === 'Enter') {
                    e.preventDefault();
                    const btn = document.getElementById(el === registerVisible ? 'domain-check' : 'transfer-check');
                    if (btn) btn.click();
                }
            });
        });
        function kzdShowDomainError(box, message) {
            if (!box) return;
            box.classList.remove('kzd-dsug');
            box.textContent = message;
            box.style.display = '';
        }

        const transferCheck = document.getElementById('transfer-check');
        if (transferCheck) {
            transferCheck.addEventListener('click', function (event) {
                const transferErr = document.getElementById('transfer-check-error');
                if (transferErr) transferErr.style.display = 'none';
                const parsed = window.KZDDomain ? window.KZDDomain.parse(transferVisible.value, kzdTransferableTlds) : { ok: false, error: 'Enter a domain.' };
                if (!parsed.ok) { kzdShowDomainError(transferErr, parsed.error); return false; }
                document.querySelector('input[name="transfer_sld"]').value = parsed.sld;
                document.querySelector('input[name="transfer_tld"]').value = parsed.tld;
                const sld = parsed.sld;
                const tld = parsed.tld;
                document.getElementById('domain-action').value = 'transfer';
                const domain = sld + tld;

                FOSSBilling.api.guest.post(
                    'servicedomain/can_be_transferred',
                    {sld: sld, tld: tld},
                    function (result) {
                        setTransferPricing(tld);
                        const domainNameEl = document.getElementById('domain-name');
                        if (domainNameEl) domainNameEl.textContent = domain;
                        const transferConfig = document.getElementById('domain-transfer-config');
                        if (transferConfig) fadeIn(transferConfig);
                        const onAfterDomainCheck = document.querySelector('.onAfterDomainCheck');
                        if (onAfterDomainCheck) fadeIn(onAfterDomainCheck);

                        const transferOrderButton = document.querySelector('#transfer .order-button');
                        if (transferOrderButton) transferOrderButton.style.display = '';
                    },
                );

                return false;
            });
        }

        const domainCheck = document.getElementById('domain-check');
        if (domainCheck) {
            domainCheck.addEventListener('click', function (event) {
                const errorBox = document.getElementById('domain-check-error');
                if (errorBox) errorBox.style.display = 'none';
                const parsed = window.KZDDomain ? window.KZDDomain.parse(registerVisible.value, kzdRegisterableTlds) : { ok: false, error: 'Enter a domain.' };
                if (!parsed.ok) { kzdShowDomainError(errorBox, parsed.error); return false; }
                document.querySelector('input[name="register_sld"]').value = parsed.sld;
                document.querySelector('input[name="register_tld"]').value = parsed.tld;
                const sld = parsed.sld;
                const tld = parsed.tld;
                const domain = sld + tld;
                document.getElementById('domain-action').value = 'register';
                const onAfterDomainCheck = document.querySelector('.onAfterDomainCheck');
                if (onAfterDomainCheck) onAfterDomainCheck.style.display = 'none';
                const registerOrderButton = document.querySelector('#register .order-button');
                if (registerOrderButton) registerOrderButton.style.display = 'none';

                FOSSBilling.api.guest.post(
                    'servicedomain/check',
                    {sld: sld, tld: tld},
                    function (result) {
                        setPricing(tld);
                        const domainNameEl = document.getElementById('domain-name');
                        if (domainNameEl) domainNameEl.textContent = domain;
                        if (onAfterDomainCheck) fadeIn(onAfterDomainCheck);
                        if (registerOrderButton) registerOrderButton.style.display = '';
                    },
                    function (err) {
                        if (!errorBox || !window.KZDDomain) return;
                        window.KZDDomain.renderSuggestions(errorBox, {
                            sld: sld, tld: tld, message: err && err.message,
                            tlds: kzdTldPrices, currency: kzdCurrencyCode,
                            onPick: function (altTld) {
                                registerVisible.value = sld + altTld;
                                registerVisible.dispatchEvent(new Event('input'));
                                domainCheck.click();
                            },
                        });
                    },
                );

                return false;
            });
        }

        function setPricing(tld) {
            FOSSBilling.api.guest.post(
                'servicedomain/pricing',
                {tld: tld},
                function (result) {
                    const yearsSelect = document.getElementById('registration-years');
                    if (!yearsSelect) return;
                    yearsSelect.innerHTML = '';

                    const regPrice = Number(result.price_registration);
                    let renewPrice = Number(result.price_renew);

                    if (result.price_renew === null || typeof result.price_renew === 'undefined' || isNaN(renewPrice)) {
                        renewPrice = regPrice;
                    }

                    const yearLabel = "{{ ' Year @ '|trans }}";
                    const yearsLabel = "{{ ' Years @ '|trans }}";

                    for (let i = 1; i <= 5; i++) {
                        const totalPrice = (i === 1) ? regPrice : regPrice + (i - 1) * renewPrice;
                        const priceFormatted = formatCurrency(
                            totalPrice,
                            {{ currency.conversion_rate }},
                            "{{ currency.code }}",
                            1
                        );

                        yearsSelect.append(
                            new Option(i + (i === 1 ? yearLabel : yearsLabel) + priceFormatted, i)
                        );
                    }

                    configNext.style.display = '';
                    configNext.disabled = false;
                },
            );
        }

        function setTransferPricing(tld) {
            FOSSBilling.api.guest.post(
                'servicedomain/pricing',
                {tld: tld},
                function (result) {
                    const price = formatCurrency(result.price_transfer, {{ currency.conversion_rate }}, "{{ currency.code }}");
                    const transferPriceEl = document.getElementById('transfer-price');
                    if (transferPriceEl) transferPriceEl.textContent = price;
                    configNext.style.display = '';
                    configNext.disabled = false;
                },
            );
        }

        // Handle URL parameters for pre-filling domain form
        const urlParams = new URLSearchParams(window.location.search);

        // The home page sends register_sld + register_tld and the visible
        // field is rendered from them. Older links used ?name= / ?tld=.
        const tldParam = urlParams.get('register_tld') || urlParams.get('tld');
        const nameParam = urlParams.get('register_sld') || urlParams.get('name');
        if (nameParam) {
            const full = nameParam.indexOf('.') === -1 && tldParam ? nameParam + tldParam : nameParam;
            [registerVisible, transferVisible].forEach(function (el) {
                if (el && !el.value.trim()) { el.value = full; el.dispatchEvent(new Event('input')); }
            });
        }

        /* KZD Solutions addition: the visitor already searched on the home
           page. If a domain name came through in the URL, run the lookup
           once on load so the results are on screen when they arrive,
           instead of showing them a filled-in form and a Search button.

           Guarded on the NAME, not the extension: an extension card alone
           carries no query to run, so that case just focuses the field. */
        (function () {
            const sldInput = registerVisible;
            const searchBtn = document.getElementById('domain-check');
            if (!sldInput || !searchBtn) { return; }

            const carried = (urlParams.get('register_sld') || urlParams.get('name') || '').trim();
            if (carried && urlParams.get('action') !== 'transfer') {
                // After the current tick, so the form's own listeners are in
                // place first.
                setTimeout(function () { searchBtn.click(); }, 0);
            } else if (urlParams.get('register_tld') || urlParams.get('tld')) {
                // Extension chosen but no name yet: put the cursor where the
                // next thing they have to do is.
                try { sldInput.focus({ preventScroll: true }); } catch (e) { sldInput.focus(); }
            }
        })();

        // KZD Solutions addition: carry the EPP/auth code the customer already
        // typed on the website's transfer page through to this form, instead
        // of silently discarding it and making them re-enter it.
        const eppParam = urlParams.get('epp');
        if (eppParam) {
            const transferCodeInput = document.querySelector('input[name="transfer_code"]');
            if (transferCodeInput) {
                transferCodeInput.value = eppParam;
            }
        }

        // KZD Solutions addition: honour ?action=transfer from the website so a
        // customer coming from the "Transfer a Domain" page lands directly on
        // the Transfer tab instead of Register, with the domain still prefilled
        // (the fields above are shared between both tabs already).
        const actionParam = urlParams.get('action');
        if (actionParam === 'transfer') {
            const transferTabEl = document.getElementById('transfer-tab');
            if (transferTabEl && window.bootstrap && window.bootstrap.Tab) {
                new window.bootstrap.Tab(transferTabEl).show();
            }
            document.getElementById('domain-action').value = 'transfer';
        }

        // KZD Solutions addition: if the customer already searched (or
        // entered a transfer domain) on the website, auto-run the same
        // availability/transferability check here instead of making them
        // click Check a second time for the exact same domain.
        if (nameParam && actionParam === 'transfer' && transferCheck) {
            transferCheck.click();
        }
    });
</script>

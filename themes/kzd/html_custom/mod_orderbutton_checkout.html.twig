{#
  KZD Solutions redesign of the Orderbutton checkout step — cart items +
  payment method combined on one screen (2-column: cart/promo/cross-sell on
  the left, sticky order summary + payment + Pay Now on the right), matching
  the reference site's single "cart + payment" page instead of a plain
  Bootstrap table. All form actions/ids/names kept identical to stock
  (#checkoutButton, #loginMessage, name="gateway_id", cart/checkout,
  cart/apply_promo, cart/remove_promo, cart/remove_item) so nothing about
  how the order actually submits changed -- only markup/styling.
#}
{% set cart = guest.cart_get %}
<div class="accordion-item kzd-order-panel">
    <h3 class="accordion-header kzd-order-panel-header">
        {# Resume the purchase. A signed-in visitor with something already in
           the cart belongs on this step whether or not the URL still carries
           ?checkout=1 — returning to a plain /order used to drop them back
           at "Select Product", the first step of a purchase they were
           already halfway through. `not request.product` keeps this out of
           the way while they are configuring a specific product, so exactly
           one panel ever carries `show`: the accordion is data-bs-parent
           bound and silently collapses all but one if more than one does. #}
        {% set kzd_cart_count = cart.items is defined and cart.items ? cart.items|length : 0 %}
        {% set kzd_open_checkout = client and kzd_cart_count > 0 and not request.product %}
        <button class="accordion-button {% if not kzd_open_checkout %}collapsed{%endif%}" type="button" data-bs-toggle="collapse" data-bs-target="#checkout" aria-expanded="{{ kzd_open_checkout ? 'true' : 'false' }}" aria-controls="checkout">
            <span class="kzd-order-panel-step">2</span>
            {{ 'Checkout'|trans }}
        </button>
    </h3>
    {% if cart.items %}
    {% set cart_currency = guest.cart_get_currency %}
    <div id="checkout" class="accordion-collapse collapse {% if kzd_open_checkout %}show{%endif%}" data-bs-parent="#orderManager">
        <div class="accordion-body">
            <div class="accordion-inner kzd-checkout-grid" id="checkout-inner">
                <div class="kzd-checkout-col-main">
                    <div class="kzd-cart-items">
                        {% for i, item in cart.items %}
                            {# Icon by item type -- domain/hosting are this site's two real
                               product types, everything else (a one-time custom item, etc.)
                               falls back to a plain cart icon rather than guessing. #}
                            {% set kzd_item_icon = item.type == 'domain' ? 'search' : (item.type == 'hosting' ? 'settings' : 'shopping-cart') %}
                            <div class="kzd-cart-item">
                                <div class="kzd-cart-item-icon"><svg class="icon"><use href="#{{ kzd_item_icon }}" /></svg></div>
                                <div class="kzd-cart-item-info">
                                    <span class="kzd-cart-item-title">
                                        {{ item.title }}
                                        {% if item.quantity > 1 %} x {{ item.quantity }}{% endif %}
                                        {# is defined, not just a bare truthiness check: a one-time-price
                                           (type=once) cart item's array has no 'period' key at all, and
                                           this theme's Twig config throws on accessing a genuinely
                                           undefined key rather than treating it as null -- hit for real
                                           testing the R29 Website Generation product's checkout. #}
                                        {% if item.period is defined and item.period %} <span class="kzd-cart-item-period">({{ item.period|period_title }})</span>{% endif %}
                                    </span>
                                    {% if request.show_custom_form_values and item.form_id and guest.extension_is_on({"mod":"formbuilder"}) %}
                                        {% set form = guest.formbuilder_get({"id": item.form_id}) %}
                                        <dl class="kzd-cart-item-formvalues">
                                            {% for field, value in item %}
                                                {% for form_field in form.fields %}
                                                    {% if value is not empty and form_field.name == field %}
                                                        <dt>{{ form_field.label }}</dt>
                                                        <dd>
                                                            {% if form_field.type == "checkbox" %}
                                                                {% for selection in value %}
                                                                    {% for field_key,field_value in form_field.options %}
                                                                        {% if field_value == selection %}{{ field_key }}{% endif %}
                                                                    {% endfor %}
                                                                {% endfor %}
                                                            {% elseif form_field.type == "select" or form_field.type == "radio" %}
                                                                {% for field_key,field_value in form_field.options %}
                                                                    {% if field_value == value %}{{ field_key }}{% endif %}
                                                                {% endfor %}
                                                            {% else %}
                                                                {{ value }}
                                                            {% endif %}
                                                        </dd>
                                                    {% endif %}
                                                {% endfor %}
                                            {% endfor %}
                                        </dl>
                                    {% endif %}
                                    {% if item.setup_price != 0 %}
                                        <span class="kzd-cart-item-setup">
                                            {{ item.title }} {{ 'setup'|trans }}:
                                            {% if item.discount_setup %}
                                                <del>{{ (item.setup_price * cart_currency.conversion_rate)|format_currency(cart_currency.code) }}</del>
                                                {{ ((item.setup_price - item.discount_setup) * cart_currency.conversion_rate)|format_currency(cart_currency.code) }}
                                            {% else %}
                                                {{ (item.setup_price * cart_currency.conversion_rate)|format_currency(cart_currency.code) }}
                                            {% endif %}
                                        </span>
                                    {% endif %}
                                </div>
                                <div class="kzd-cart-item-price">
                                    {% if item.discount_price %}
                                        <del>{{ (item.total * cart_currency.conversion_rate)|format_currency(cart_currency.code) }}</del>
                                        <strong>{{ ((item.total - item.discount_price) * cart_currency.conversion_rate)|format_currency(cart_currency.code) }}</strong>
                                    {% else %}
                                        <strong>{{ (item.total * cart_currency.conversion_rate)|format_currency(cart_currency.code) }}</strong>
                                    {% endif %}
                                </div>
                                <a class="kzd-cart-item-remove" title="{{ 'Remove item'|trans }}"
                                   {{ fb_api_link({href: 'cart/remove_item'|api_url(query: {id: item.id}, role: 'guest'), modal: {type: 'confirm', title: 'Are you sure?'|trans, content: 'Are you sure you want to remove this item from cart?'|trans}, reload: true}) }}>
                                    <svg class="icon"><use href="#x" /></svg>
                                </a>
                            </div>
                        {% endfor %}
                    </div>

                    {% set cross_sell_domain_item = null %}
                    {% set has_hosting_item = false %}
                    {% for item in cart.items %}
                        {% if item.type == 'hosting' %}
                            {% set has_hosting_item = true %}
                        {% elseif item.type == 'domain' %}
                            {% set cross_sell_domain_item = item %}
                        {% endif %}
                    {% endfor %}

                    {% set cross_sell_hosting_ids = [] %}
                    {% if cross_sell_domain_item is not null and not has_hosting_item %}
                        {% set cross_sell_source_product = guest.product_get({"id": cross_sell_domain_item.product_id}) %}
                        {# The admin form always submits an empty placeholder value alongside
                           the checked boxes (so unchecking everything still clears the saved
                           list) -- filter it back out here rather than trusting the stored
                           array is already clean. #}
                        {% set raw_cross_sell_ids = cross_sell_source_product.config.cross_sell_products|default([]) %}
                        {% for raw_id in raw_cross_sell_ids %}
                            {% if raw_id is not empty %}
                                {% set cross_sell_hosting_ids = cross_sell_hosting_ids|merge([raw_id]) %}
                            {% endif %}
                        {% endfor %}
                    {% endif %}

                    {% if cross_sell_hosting_ids is not empty %}
                        {% set cross_sell_currency = guest.cart_get_currency %}
                        {% set cs_action = cross_sell_domain_item.action %}
                        {% set cs_sld = cs_action == 'transfer' ? cross_sell_domain_item.transfer_sld : cross_sell_domain_item.register_sld %}
                        {% set cs_tld = cs_action == 'transfer' ? cross_sell_domain_item.transfer_tld : cross_sell_domain_item.register_tld %}
                        {# Real per-plan specs (websites/storage/mailboxes) pulled directly
                           from each plan's actual service_hosting_hp provisioning config,
                           not invented copy -- keyed by product id since that spec table
                           isn't exposed through the customer-facing product API. Update
                           this map if a plan's real limits ever change in admin. #}
                        {% set kzd_hosting_specs = {
                            2: ['1 website', '2 GB storage', '10 mailboxes'],
                            3: ['2 websites', '4 GB storage', '15 mailboxes'],
                            4: ['5 websites', '7 GB storage', '25 mailboxes'],
                            5: ['10 websites', '15 GB storage', '50 mailboxes']
                        } %}
                        {# User's own call (not inferred/fabricated popularity data):
                           Standard Hosting (id 4) is the one plan flagged "Recommended". #}
                        {% set kzd_recommended_hosting_id = 4 %}
                        <div class="kzd-plan-section">
                            <div class="kzd-plan-section-head">
                                <div class="kzd-plan-section-copy">
                                    <h2>{{ 'Complete your setup'|trans }}</h2>
                                    <p>{{ cs_sld }}{{ cs_tld }} {{ 'needs hosting to go live. Pick a plan below. You can change it anytime.'|trans }}</p>
                                </div>
                                <div class="kzd-billing-toggle-wrap">
                                    <div class="kzd-billing-toggle">
                                        <input type="radio" name="kzd-billing" id="kzd-billing-monthly" checked>
                                        <label for="kzd-billing-monthly">{{ 'Monthly'|trans }}</label>
                                        <input type="radio" name="kzd-billing" id="kzd-billing-yearly">
                                        <label for="kzd-billing-yearly">{{ 'Yearly'|trans }}</label>
                                    </div>
                                    <span class="kzd-billing-toggle-note">{{ 'Switch to yearly for 2 months free'|trans }}</span>
                                </div>
                            </div>

                            <div class="kzd-plan-grid" id="kzd-plan-grid">
                                {% for hosting_id in cross_sell_hosting_ids %}
                                    {% set hosting_product = guest.product_get({"id": hosting_id}) %}
                                    {% if hosting_product and hosting_product.pricing.recurrent['1M'].enabled %}
                                        {% set is_recommended = hosting_id == kzd_recommended_hosting_id %}
                                        {% set monthly_price = hosting_product.pricing.recurrent['1M'].price %}
                                        {% set yearly_total = hosting_product.pricing.recurrent['1Y'].enabled ? hosting_product.pricing.recurrent['1Y'].price : null %}
                                        <div class="kzd-plan-card{{ is_recommended ? ' is-recommended' : '' }}">
                                            {% if is_recommended %}<div class="kzd-plan-card-ribbon">{{ 'Most popular'|trans }}</div>{% endif %}
                                            <div class="kzd-plan-card-body">
                                                <span class="kzd-plan-card-name">{{ hosting_product.title }}</span>
                                                <div class="kzd-plan-card-price">
                                                    <span class="kzd-plan-price-monthly">
                                                        <span class="kzd-plan-price-currency">{{ cross_sell_currency.code }}</span>
                                                        <span class="kzd-plan-price-amount">{{ (monthly_price * cross_sell_currency.conversion_rate)|number_format(2) }}</span>
                                                        <span class="kzd-plan-price-period">/{{ 'mo'|trans }}</span>
                                                    </span>
                                                    {% if yearly_total %}
                                                        <span class="kzd-plan-price-yearly">
                                                            <span class="kzd-plan-price-currency">{{ cross_sell_currency.code }}</span>
                                                            <span class="kzd-plan-price-amount">{{ (yearly_total / 12 * cross_sell_currency.conversion_rate)|number_format(2) }}</span>
                                                            <span class="kzd-plan-price-period">/{{ 'mo'|trans }}</span>
                                                        </span>
                                                        <span class="kzd-plan-price-yearly-note">{{ (yearly_total * cross_sell_currency.conversion_rate)|format_currency(cross_sell_currency.code) }} {{ 'billed yearly'|trans }}</span>
                                                    {% endif %}
                                                </div>
                                                <span class="kzd-plan-card-divider"></span>
                                                <ul class="kzd-plan-card-features">
                                                    {% for feature in kzd_hosting_specs[hosting_id]|default([]) %}
                                                        <li><svg class="icon"><use href="#check" /></svg>{{ feature }}</li>
                                                    {% endfor %}
                                                </ul>
                                                <a class="kzd-plan-card-cta kzd-press"
                                                   data-kzd-plan-href-monthly="{{ 'order'|url(query: {'product': hosting_id, 'action': 'owndomain', 'owndomain_sld': cs_sld, 'owndomain_tld': cs_tld, 'linked_domain': 1, 'period': '1M'}) }}"
                                                   data-kzd-plan-href-yearly="{{ 'order'|url(query: {'product': hosting_id, 'action': 'owndomain', 'owndomain_sld': cs_sld, 'owndomain_tld': cs_tld, 'linked_domain': 1, 'period': '1Y'}) }}"
                                                   href="{{ 'order'|url(query: {'product': hosting_id, 'action': 'owndomain', 'owndomain_sld': cs_sld, 'owndomain_tld': cs_tld, 'linked_domain': 1, 'period': '1M'}) }}">
                                                    <span>{{ 'Choose plan'|trans }}</span>
                                                    <svg class="icon"><use href="#arrow-right" /></svg>
                                                </a>
                                            </div>
                                        </div>
                                    {% endif %}
                                {% endfor %}
                            </div>

                            {# What every offered plan actually shares, read from the
                               products' own feature lists -- the same source the
                               homepage pricing section uses. This used to list
                               "Unlimited bandwidth", "99.9% on secure servers" and
                               "Thirty days to decide", none of which any product
                               record states. #}
                            {% set kzd_cs_feats = [] %}
                            {% for hosting_id in cross_sell_hosting_ids %}
                                {% set hp = guest.product_get({"id": hosting_id}) %}
                                {% if hp %}
                                    {% set kzd_cs_feats = kzd_cs_feats|merge([(hp.description|default(''))|split('\n')|filter(l => l|trim starts with '- ')|map(l => l|trim|slice(2))]) %}
                                {% endif %}
                            {% endfor %}
                            {% set kzd_cs_shared = kzd_cs_feats ? (kzd_cs_feats|first)|filter(f => kzd_cs_feats|filter(fl => f in fl)|length == kzd_cs_feats|length) : [] %}
                            {% if kzd_cs_shared|length > 0 %}
                                <div class="kzd-plan-includes">
                                    <span class="kzd-plan-includes-label">{{ 'Every plan includes'|trans }}</span>
                                    {% for f in kzd_cs_shared %}
                                        <span>{{ f }}</span>
                                    {% endfor %}
                                </div>
                            {% endif %}
                        </div>

                        <script>
                        (function () {
                            var grid = document.getElementById('kzd-plan-grid');
                            var yearlyToggle = document.getElementById('kzd-billing-yearly');
                            if (!grid || !yearlyToggle) return;
                            function applyBilling() {
                                var yearly = yearlyToggle.checked;
                                grid.classList.toggle('is-yearly', yearly);
                                grid.querySelectorAll('.kzd-plan-card-cta').forEach(function (link) {
                                    var href = link.getAttribute(yearly ? 'data-kzd-plan-href-yearly' : 'data-kzd-plan-href-monthly');
                                    if (href) link.setAttribute('href', href);
                                });
                            }
                            document.getElementById('kzd-billing-monthly').addEventListener('change', applyBilling);
                            yearlyToggle.addEventListener('change', applyBilling);
                        })();
                        </script>
                    {% endif %}

                </div>

                <div class="kzd-checkout-col-side">
                    <div class="kzd-order-summary">
                        <h4>{{ 'Order summary'|trans }}</h4>
                        <ul class="kzd-summary-items">
                            {% for item in cart.items %}
                                <li>
                                    <span class="kzd-summary-item-name">
                                        {{ item.title }}
                                        {% if item.period is defined and item.period %}<span class="kzd-summary-item-period">{{ item.period|period_title }}</span>{% endif %}
                                    </span>
                                    <span class="kzd-summary-item-price">
                                        {% if item.discount_price %}
                                            {{ ((item.total - item.discount_price) * cart_currency.conversion_rate)|format_currency(cart_currency.code) }}
                                        {% else %}
                                            {{ (item.total * cart_currency.conversion_rate)|format_currency(cart_currency.code) }}
                                        {% endif %}
                                    </span>
                                </li>
                            {% endfor %}
                        </ul>
                        <div class="kzd-promo-row">
                            {% if not cart.promocode %}
                                <a href="#" id="show-promo-field" class="kzd-promo-link">{{ 'Have a promo code?'|trans }}</a>
                            {% endif %}
                            <form method="post" action="{{ 'cart/apply_promo'|api_url(role: 'guest') }}" {{ fb_api_form({message: 'Promo Code Applied to Order'|trans, reload: true}) }}
                                class="kzd-promo-form" {% if not cart.promocode %}style="display:none"{% endif %} id="apply-promo">
                                <input type="text" name="promocode" id="promocode" value="{{ request.promocode|default(cart.promocode) }}" {% if promo|default({}).required|default(false) %}required="required"{% endif %} placeholder="{{ 'Enter code'|trans }}">
                                {% if cart.promocode %}
                                    <a class="kzd-promo-remove" href="{{ 'cart/remove_promo'|api_url(role: 'guest') }}" type="button" {{ fb_api_link({reload: true}) }}>{{ 'Remove'|trans }}</a>
                                {% else %}
                                    <button class="kzd-promo-apply kzd-press" type="submit">{{ 'Apply'|trans }}</button>
                                {% endif %}
                            </form>
                        </div>
                        <table class="kzd-summary-table">
                            {% if cart.discount > 0 %}
                                <tr>
                                    <td>{{ 'Subtotal'|trans }}</td>
                                    <td>{{ (cart.subtotal * cart_currency.conversion_rate)|format_currency(cart_currency.code) }}</td>
                                </tr>
                                <tr>
                                    <td>{{ 'Discount'|trans }}</td>
                                    <td>- {{ (cart.discount * cart_currency.conversion_rate)|format_currency(cart_currency.code) }}</td>
                                </tr>
                            {% endif %}
                            {% set tax_amount = 0 %}
                            {% if client and client.client_is_taxable %}
                                {% set tax_rate = client.invoice_get_tax_rate %}
                                {% set tax_amount = cart.total * tax_rate / 100 %}
                                <tr>
                                    <td>{{ 'VAT'|trans }} ({{ tax_rate }}%)</td>
                                    <td>{{ (tax_amount * cart_currency.conversion_rate)|format_currency(cart_currency.code) }}</td>
                                </tr>
                            {% endif %}
                            <tr class="kzd-summary-total">
                                <td>{{ 'Total due today'|trans }}</td>
                                <td>{{ ((cart.total + tax_amount) * cart_currency.conversion_rate)|format_currency(cart_currency.code) }}</td>
                            </tr>
                        </table>

                        <form method="post" action="{{ 'cart/checkout'|api_url }}" {{ fb_api_form({callback: 'onOrderCheckout'}) }}>
                            <fieldset>
                                {% set enough_in_balance = client ? client.client_balance_get_total >= cart.total : false %}
                                {% if cart.total and not enough_in_balance %}
                                    <div class="kzd-gateway-picker">
                                        <div class="kzd-gateway-heading">
                                            <h4>{{ 'Payment method'|trans }}</h4>
                                        </div>
                                        {% set gateway_selected = false %}
                                        {% for gtw in guest.invoice_gateways %}
                                            {% if cart.currency.code in gtw.accepted_currencies and (gtw.allow_single or (cart.subscribable|default(false) and gtw.allow_recurrent)) %}
                                                {% set gateway_input_id = 'order-gateway-' ~ gtw.id %}
                                                <label class="kzd-gateway-option kzd-press" for="{{ gateway_input_id }}">
                                                    <input type="radio" name="gateway_id" id="{{ gateway_input_id }}" value="{{ gtw.id }}" autocomplete="off" {{ not gateway_selected ? 'checked' : '' }}/>
                                                    <span class="kzd-gateway-radio-dot"></span>
                                                    <span class="kzd-gateway-icon"><svg class="icon"><use href="#credit-card" /></svg></span>
                                                    <span class="kzd-gateway-name">{{ gtw.title == 'Paystack' ? 'Pay with card'|trans : gtw.title }}</span>
                                                </label>
                                                {% set gateway_selected = true %}
                                            {% endif %}
                                        {% endfor %}
                                    </div>
                                {% endif %}
                                {% if enough_in_balance %}
                                    <p class="kzd-balance-note">{{ 'Total amount will be deducted from account balance'|trans }}</p>
                                {% endif %}
                                {% if settings.checkout_tos|default('0') == 'explicit' %}
                                    <label class="kzd-tos-check">
                                        <input type="checkbox" value="" id="flexCheckDefault" required>
                                        <span>I agree to the <a href="{{ 'tos'|url }}" target="_blank">{{ 'Terms of Service'|trans }}</a> and <a href="{{ 'privacy-policy'|url }}" target="_blank">{{ 'Privacy Policy'|trans }}</a>.</span>
                                    </label>
                                {% endif %}
                                <button id="checkoutButton" class="kzd-pay-now-btn kzd-press" type="submit" {% if not client %} hidden="true" {% endif %}>
                                    <span>{{ 'Pay Now'|trans }}</span>
                                    <svg class="icon kzd-pay-now-btn-arrow"><use href="#arrow-right" /></svg>
                                </button>
                                <p id="loginMessage" class="kzd-login-message" {% if client %} hidden="true" {% endif %}>{{ 'Create an account or sign in above to complete your order.'|trans }}</p>
                            </fieldset>
                            {% if settings.checkout_tos|default('0') == 'implicit' %}
                                <p class="kzd-tos-implicit">By completing your order, you agree to our <a href="{{ 'tos'|url }}" target="_blank">{{ 'Terms of Service'|trans }}</a> and <a href="{{ 'privacy-policy'|url }}" target="_blank">{{ 'Privacy Policy'|trans }}</a>.</p>
                            {% endif %}
                            <p class="kzd-checkout-trust">
                                <svg class="icon"><use href="#lock" /></svg>{{ 'Secure checkout &middot; cancel hosting anytime'|trans|raw }}
                            </p>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
    {% endif %}
</div>

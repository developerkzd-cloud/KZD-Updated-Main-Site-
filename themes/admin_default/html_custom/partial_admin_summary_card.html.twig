{#
  KZD Solutions override of the stock admin summary-card partial.

  Only change: the header row (title/subtitle + optional summary_header_aside
  block) was `d-flex justify-content-between align-items-start gap-3` with no
  wrap/stack behaviour. Its only current consumer with an aside is the
  Client detail page (mod_client_manage.html.twig), which puts a 112px
  avatar there next to the client's name/subtitle -- on a narrow screen
  that can push the avatar off-canvas or clip the subtitle text. Stacks
  below sm (avatar under the text), row above, same shape as the other
  mobile fixes this pass.
#}
{% set _summary_actions_fallback %}{% block summary_actions %}{% endblock %}{% endset %}
{% set summary_actions = block('summary_actions')|trim %}

<div class="card{% if card_class|default('') %} {{ card_class }}{% endif %}">
    <div class="card-body{% if body_class|default('') %} {{ body_class }}{% endif %}">
        <div class="d-flex flex-column flex-sm-row justify-content-between align-items-start gap-3">
            <div class="d-flex flex-column gap-1">
                <h5 class="card-title mb-0">{{ title }}</h5>
                {% if subtitle is defined and subtitle %}
                    <p class="text-secondary mb-0">{{ subtitle }}</p>
                {% endif %}
            </div>
            {% block summary_header_aside %}{% endblock %}
        </div>
    </div>

    {% block summary_content %}{% endblock %}

    {% if summary_actions %}
        <div class="card-footer{% if centered_actions|default(false) %} text-center{% endif %}">
            {% if centered_actions|default(false) %}
                <div class="btn-list justify-content-center">
                    {{ summary_actions|raw }}
                </div>
            {% else %}
                {{ summary_actions|raw }}
            {% endif %}
        </div>
    {% endif %}
</div>

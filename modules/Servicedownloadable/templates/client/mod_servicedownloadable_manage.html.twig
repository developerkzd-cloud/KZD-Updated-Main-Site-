{% if order.status == 'active' %}
{% if not service %}
<div class="card mb-4">
    <div class="card-body">
        <div class="alert alert-warning mb-0">
            {{ 'The downloadable file service for this order could not be found. It may not have been provisioned yet, or its service record may have been removed.'|trans }}
        </div>
    </div>
</div>
{% else %}
<div class="card mb-4">
    <div class="card-header">
        <h2>{{ 'Download'|trans }} {{ service.filename }}</h2>
    </div>
    <div class="card-body">
        <a class="btn btn-primary btn-large" href='{{ "servicedownloadable/get-file/#{order.id}"|url }}'>{{ 'Download'|trans }}</a>
    </div>
</div>
{% endif %}
{% endif %}
